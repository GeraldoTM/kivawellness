{% comment %}
  product-comparison-drawer.liquid
  Full-specifications drawer for product-comparison.liquid.

  USAGE:
    {% render 'product-comparison-drawer', product_blocks: product_blocks, section: section %}

  DATA MODEL:
    Each drawer group's VALUES are pulled AUTOMATICALLY from the connected
    product's own metafield first:
      product.metafields.custom.heating_flyout.value       -> type: heating_flyout
      product.metafields.custom.build_flyout.value         -> type: build_flyout
      product.metafields.custom.installation_flyout.value  -> type: installation_flyout
      product.metafields.custom.features_flyout.value      -> type: features_flyout
      product.metafields.custom.warranty_flyout.value      -> type: warranty_flyout
    If a product doesn't have that metafield set, it falls back to the
    manual metaobject picker on the block (block.settings.heating_flyout,
    etc.) — so the manual pickers still work as an override or a fallback
    for products missing the metafield, they're just no longer required.

    ASSUMPTION TO VERIFY: namespace "custom" and metafield handles matching
    the metaobject type names exactly. Adjust if your actual metafield
    setup differs.

    Metaobject fields are accessed directly by handle (e.g. heating.heater_power),
    same as metafields — no ".value" needed for these simple field types.

    The 5 group HEADINGS (Heating, Build, Installation, Features, Warranty)
    and the field LABELS inside them are fixed in this file's markup, not
    merchant-editable. Only the metaobject entry referenced per product
    changes what's shown.

    The tab label is block.settings.short_name — a plain static text field
    on the product block itself, independent of any metaobject or the
    connected product. It's a label only, never treated as a spec row.

  Each group is a native <details>/<summary> element, so expand/collapse
  needs no JavaScript and is accessible by default. All groups start open
  to match the approved design; the browser's native disclosure behavior
  handles the rest.
{% endcomment %}

{%- if product_blocks.size > 0 -%}
  <div class="pc-drawer-overlay" id="pc-overlay"></div>
  <div class="pc-drawer" id="pc-drawer" role="dialog" aria-modal="true" aria-label="Full comparison">
    <div class="pc-drawer-header">
      <h2>{{ section.settings.drawer_title | default: 'Full Specifications' }}</h2>
      <button class="pc-drawer-close" id="pc-close-drawer" aria-label="Close">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="pc-drawer-tabs">
      {%- for block in product_blocks -%}
        <button class="pc-drawer-tab{% if forloop.first %} active{% endif %}" data-product-index="{{ forloop.index0 }}">
          {{ block.settings.short_name | default: 'Product' | upcase }}
        </button>
      {%- endfor -%}
    </div>

    <div class="pc-drawer-body">
      {%- for block in product_blocks -%}
        <div
          class="pc-drawer-panel"
          data-panel-index="{{ forloop.index0 }}"
          {% unless forloop.first %}
            hidden
          {% endunless %}
        >
          {%- comment -%}
            Automatic-first: each group pulls from the connected product's
            own metafield (product.metafields.custom.<name>) by default —
            since that's a metaobject_reference metafield, .value resolves
            it to the actual metaobject, same shape as the manual picker
            below. The manual block setting (heating_flyout, etc.) only
            kicks in as a fallback when the product metafield is empty.

            ASSUMPTION TO VERIFY: namespace "custom" and metafield handles
            matching the metaobject type names exactly (heating_flyout,
            build_flyout, installation_flyout, features_flyout,
            warranty_flyout). Adjust these if your actual metafield setup
            differs.
          {%- endcomment -%}
          {%- assign product = block.settings.product -%}
          {%- assign heating = product.metafields.custom.heating_flyout.value | default: block.settings.heating_flyout -%}
          {%- assign build = product.metafields.custom.build_flyout.value | default: block.settings.build_flyout -%}
          {%- assign installation = product.metafields.custom.installation_flyout.value | default: block.settings.installation_flyout -%}
          {%- assign features = product.metafields.custom.features_flyout.value | default: block.settings.features_flyout -%}
          {%- assign warranty = product.metafields.custom.warranty_flyout.value | default: block.settings.warranty_flyout -%}

          {%- comment -%} ================= HEATING ================= {%- endcomment -%}
          <details class="pc-drawer-group" open>
            <summary class="pc-drawer-group-header">
              <span class="pc-drawer-group-title">
                <svg
                  class="pc-drawer-group-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 2c1 3-2 4-2 7a3 3 0 0 0 6 0c0-1-.4-1.8-1-2.5.7 2.3-1 3.5-2 3.5-1.2 0-2-1-1.7-2.3.5-2 .9-3.7-1.3-5.7Z"/>
                  <path d="M8.5 12.5c-1.5 1.6-2 3-2 4.5a5.5 5.5 0 0 0 11 0c0-2-1-3.7-2.3-5"/>
                </svg>
                Heating
              </span>
              <svg
                class="pc-drawer-group-chevron"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </summary>
            <div class="pc-drawer-group-body">
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Temperature Range</span>
                <span class="pc-drawer-spec-value">
                  {%- if heating.min_temperature != blank or heating.max_temperature != blank -%}
                    {{ heating.min_temperature | default: '—' }}°C - {{ heating.max_temperature | default: '—' }}°C
                  {%- else -%}
                    —
                  {%- endif -%}
                </span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Heater Type</span>
                <span class="pc-drawer-spec-value">{{ heating.heating_system | default: '—' }}</span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Infrared Spectrum</span>
                <span class="pc-drawer-spec-value">{{ heating.infrared_spectrum | default: '—' }}</span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Heating Elements</span>
                <span class="pc-drawer-spec-value">{{ heating.heating_elements | default: '—' }}</span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Warm Up Time</span>
                <span class="pc-drawer-spec-value">{{ heating.warm_up_time | default: '—' }}</span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Power Output</span>
                <span class="pc-drawer-spec-value">{{ heating.heater_power | default: '—' }}</span>
              </div>
            </div>
          </details>

          {%- comment -%} ================= BUILD ================= {%- endcomment -%}
          <details class="pc-drawer-group" open>
            <summary class="pc-drawer-group-header">
              <span class="pc-drawer-group-title">
                <svg
                  class="pc-drawer-group-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M14.7 6.3 17 4a2.1 2.1 0 0 1 3 3l-2.3 2.3"/>
                  <path d="m9 15-4.5 4.5a1.5 1.5 0 0 0 0 2.1 1.5 1.5 0 0 0 2.1 0L11 17"/>
                  <path d="m13 7 5.5 5.5"/>
                  <path d="M6.5 8.5 4 6a2.1 2.1 0 0 1 3-3l2.5 2.5"/>
                  <path d="m9 6 9 9-2 2-9-9Z"/>
                </svg>
                Build
              </span>
              <svg
                class="pc-drawer-group-chevron"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </summary>
            <div class="pc-drawer-group-body">
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Timber</span>
                <span class="pc-drawer-spec-value">{{ build.timber | default: '—' }}</span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Exterior Dimensions (W x D x H)</span>
                <span class="pc-drawer-spec-value">
                  {%- if build.width_mm != blank or build.depth_mm != blank or build.height_mm != blank -%}
                    {{ build.width_mm | default: '—' }} x {{ build.depth_mm | default: '—' }} x
                    {{ build.height_mm | default: '—' }} mm
                  {%- else -%}
                    —
                  {%- endif -%}
                </span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Interior Dimensions (W x D x H)</span>
                <span class="pc-drawer-spec-value">{{ build.interior_dimensions | default: '—' }}</span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Weight</span>
                <span class="pc-drawer-spec-value">
                  {%- if build.weight_kg != blank %}{{ build.weight_kg }} kg{% else %}—{% endif -%}
                </span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Glass</span>
                <span class="pc-drawer-spec-value">{{ build.glass | default: '—' }}</span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Ventilation</span>
                <span class="pc-drawer-spec-value">{{ build.ventilation | default: '—' }}</span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Seating</span>
                <span class="pc-drawer-spec-value">{{ build.seating | default: '—' }}</span>
              </div>
            </div>
          </details>

          {%- comment -%} ================= INSTALLATION ================= {%- endcomment -%}
          <details class="pc-drawer-group" open>
            <summary class="pc-drawer-group-header">
              <span class="pc-drawer-group-title">
                <svg
                  class="pc-drawer-group-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L2 19l3 3 7.3-7.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2-2Z"/>
                </svg>
                Installation
              </span>
              <svg
                class="pc-drawer-group-chevron"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </summary>
            <div class="pc-drawer-group-body">
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Power Connection</span>
                <span class="pc-drawer-spec-value">{{ installation.power_connection | default: '—' }}</span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Electrician Required</span>
                <span class="pc-drawer-spec-value">
                  {%- if installation.electrician_required -%}
                    <svg
                      class="pc-drawer-check"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 6 9 17l-5-5"/>
                    </svg>
                  {%- else -%}
                    —
                  {%- endif -%}
                </span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Assembly</span>
                <span class="pc-drawer-spec-value">{{ installation.assembly | default: '—' }}</span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Installation Available</span>
                <span class="pc-drawer-spec-value">
                  {%- if installation.installation_available -%}
                    <svg
                      class="pc-drawer-check"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 6 9 17l-5-5"/>
                    </svg>
                  {%- else -%}
                    —
                  {%- endif -%}
                </span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Floor Requirements</span>
                <span class="pc-drawer-spec-value">{{ installation.floor_requirements | default: '—' }}</span>
              </div>
            </div>
          </details>

          {%- comment -%} ================= FEATURES ================= {%- endcomment -%}
          <details class="pc-drawer-group" open>
            <summary class="pc-drawer-group-header">
              <span class="pc-drawer-group-title">
                <svg
                  class="pc-drawer-group-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h13M21 18h-1"/>
                  <circle cx="13" cy="6" r="2"/>
                  <circle cx="7" cy="12" r="2"/>
                  <circle cx="17" cy="18" r="2"/>
                </svg>
                Features
              </span>
              <svg
                class="pc-drawer-group-chevron"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </summary>
            <div class="pc-drawer-group-body">
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Digital Controls</span>
                <span class="pc-drawer-spec-value">
                  {%- if features.digital_controls -%}
                    <svg
                      class="pc-drawer-check"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 6 9 17l-5-5"/>
                    </svg>
                  {%- else -%}
                    —
                  {%- endif -%}
                </span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">WiFi Control</span>
                <span class="pc-drawer-spec-value">
                  {%- if features.wifi_control -%}
                    <svg
                      class="pc-drawer-check"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 6 9 17l-5-5"/>
                    </svg>
                  {%- else -%}
                    —
                  {%- endif -%}
                </span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Interior Lighting</span>
                <span class="pc-drawer-spec-value">
                  {%- if features.interior_lighting -%}
                    <svg
                      class="pc-drawer-check"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 6 9 17l-5-5"/>
                    </svg>
                  {%- else -%}
                    —
                  {%- endif -%}
                </span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Bluetooth</span>
                <span class="pc-drawer-spec-value">
                  {%- if features.bluetooth -%}
                    <svg
                      class="pc-drawer-check"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 6 9 17l-5-5"/>
                    </svg>
                  {%- else -%}
                    —
                  {%- endif -%}
                </span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Chromotherapy</span>
                <span class="pc-drawer-spec-value">
                  {%- if features.chromotherapy -%}
                    <svg
                      class="pc-drawer-check"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 6 9 17l-5-5"/>
                    </svg>
                  {%- else -%}
                    —
                  {%- endif -%}
                </span>
              </div>
              <div class="pc-drawer-spec-row">
                <span class="pc-drawer-spec-label">Airflow System</span>
                <span class="pc-drawer-spec-value">{{ features.airflow_system | default: '—' }}</span>
              </div>
            </div>
          </details>

          {%- comment -%} ================= WARRANTY ================= {%- endcomment -%}
          <details class="pc-drawer-group" open>
            <summary class="pc-drawer-group-header">
              <span class="pc-drawer-group-title">
                <svg
                  class="pc-drawer-group-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 3 4 6.5v5c0 5 3.4 8.7 8 9.5 4.6-.8 8-4.5 8-9.5v-5Z"/>
                  <path d="m9.5 12 1.8 1.8L15 10"/>
                </svg>
                Warranty
              </span>
              <svg
                class="pc-drawer-group-chevron"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </summary>
            <div class="pc-drawer-group-body">
              {%- comment -%}
                Comparison Warranty + Warranty Detail are the primary 2
                fields — shown whenever present. The granular breakdown
                (Structural, Heating, Component, Commercial) only appears
                as a group at all if at least one of them has an actual
                entry; each row within that group still only shows if
                that specific field is filled in, same "skip if blank"
                pattern used elsewhere in this file. Warranty Summary is
                intentionally ignored now — superseded by Comparison
                Warranty.
              {%- endcomment -%}
              {%- assign has_granular_warranty = false -%}
              {%- if warranty.structural_warranty != blank
                or warranty.heating_warranty != blank
                or warranty.component_warranty != blank
                or warranty.commercial_warranty != blank
              -%}
                {%- assign has_granular_warranty = true -%}
              {%- endif -%}

              {%- if warranty.comparison_warranty_rich != blank -%}
                <div class="pc-drawer-spec-row pc-drawer-spec-row--full">
                  <div class="pc-drawer-spec-detail">{{ warranty.comparison_warranty_rich | metafield_tag }}</div>
                </div>
              {%- endif -%}

              {%- if warranty.warranty_detail_rich != blank -%}
                <div class="pc-drawer-spec-row pc-drawer-spec-row--full">
                  <div class="pc-drawer-spec-detail">{{ warranty.warranty_detail_rich | metafield_tag }}</div>
                </div>
              {%- endif -%}

              {%- if has_granular_warranty -%}
                {%- if warranty.structural_warranty != blank -%}
                  <div class="pc-drawer-spec-row">
                    <span class="pc-drawer-spec-label">Structural Warranty</span>
                    <span class="pc-drawer-spec-value">{{ warranty.structural_warranty }}</span>
                  </div>
                {%- endif -%}
                {%- if warranty.heating_warranty != blank -%}
                  <div class="pc-drawer-spec-row">
                    <span class="pc-drawer-spec-label">Heating Warranty</span>
                    <span class="pc-drawer-spec-value">{{ warranty.heating_warranty }}</span>
                  </div>
                {%- endif -%}
                {%- if warranty.component_warranty != blank -%}
                  <div class="pc-drawer-spec-row">
                    <span class="pc-drawer-spec-label">Component Warranty</span>
                    <span class="pc-drawer-spec-value">{{ warranty.component_warranty }}</span>
                  </div>
                {%- endif -%}
                {%- if warranty.commercial_warranty != blank -%}
                  <div class="pc-drawer-spec-row">
                    <span class="pc-drawer-spec-label">Commercial Warranty</span>
                    <span class="pc-drawer-spec-value">{{ warranty.commercial_warranty }}</span>
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>
          </details>
        </div>
      {%- endfor -%}
    </div>

    {% comment %}
      <div class="pc-drawer-cta">
        <a href="{{ product_blocks.first.settings.product.url | default: '#' }}" id="pc-drawer-cta-link">
          View full product page
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    {% endcomment %}
  </div>
{%- endif -%}
