<style>
@media (max-width: 768px) {
  .mobile-filters {
    width: 100%;
    overflow: hidden;
    position: relative;
    margin-bottom: 2rem;
    padding-inline: 0.5rem;
  }

  .mobile-filter-scroll {
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .mobile-filter-track {
    display: flex;
    gap: 0.5rem;
    padding-inline: 0.25rem;
  }

  .filter-chip {
    flex-shrink: 0;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    background: #f1f2f6;
    font-size: 0.9rem;
    white-space: nowrap;
    color: #000;
    font-weight: var(--fontbold);
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .filter-chip.active {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  .filter-chip:hover {
    background: #000;
    color: #fff;
  }

  .mobile-filter-track > .filter-chip:first-child {
    margin-left: 0.25rem;
  }

  .mobile-filter-track > .filter-chip:last-child {
    margin-right: 0.25rem;
  }

 /* Grid rules */
  #product-grid .main-product-grid {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 12px !important;
  }

  #product-grid .main-product-grid.grid-1 {
    grid-template-columns: 1fr !important;
  }

  .view-btn.active {
    background: #000 !important;
    color: #fff !important;
  }

  .icon-control{
     border:none; 
     border-radius:6px; 
     cursor:pointer;
  }

  .mobile-facets__open {
    display: none !important;
  }

  #product-grid .main-product-grid.grid-1 .card__media,
  #product-grid .main-product-grid.grid-1 .product-card__image-wrapper,
  #product-grid .main-product-grid.grid-1 img {
    max-height: 260px;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  #product-grid .main-product-grid.grid-1 img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #product-grid .main-product-grid.grid-1 .info-dim-cont {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 6px;
    }

    #product-grid .main-product-grid.grid-1 .info-dim {
      font-size: 12px;
      line-height: 1.2;
    }

    #product-grid .main-product-grid.grid-1 .dim-pers {
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 12px;
      white-space: nowrap;
    }

    #product-grid .main-product-grid.grid-1 .title {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      line-height: 1.35;
      min-height: calc(1.35em * 2);
      margin: 8px 0 6px;
      font-size: 14px;
    }

    .mobile-toolbar.medium-hide.large-up-hide {
        margin-top: 1.3rem;
    }
}
</style>

<div class="mobile-toolbar medium-hide large-up-hide" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem; padding-inline:0.5rem; gap:0.5rem;">
  <div style="flex:1; display:flex; align-items:center;">
    <span class="product-count" style="font-size:0.95rem; font-weight:600; display: block !important;">
      {%- if collection.products_count == 1 -%}
        1 product
      {%- else -%}
        {{ collection.products_count }} products
      {%- endif -%}
    </span>
  </div>

  <div style="flex:0; display:flex; align-items:center;">
    <button data-view="single" aria-label="Single square view" class = "icon-control view-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <rect x="3" y="3" width="18" height="18"/>
      </svg>
    </button>
  </div>

  <div style="flex:0; display:flex; align-items:center;">
    <button data-view="grid" aria-label="4-square grid view" class = "icon-control view-btn active">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <rect x="3" y="3" width="7" height="7"/>
        <rect x="14" y="3" width="7" height="7"/>
        <rect x="3" y="14" width="7" height="7"/>
        <rect x="14" y="14" width="7" height="7"/>
      </svg>
    </button>
  </div>
</div>

<div class="mobile-filters medium-hide large-up-hide">
  <div class="mobile-filter-scroll">
    <div class="mobile-filter-track">

      <button class="filter-chip sort-trigger" data-filter="Sort">
        Sort By
      </button>

      {% assign shown = 0 %}
      {% for filter in collection.filters %}
        {% if shown < 4 %}
          <button
            class="filter-chip"
            data-filter="{{ filter.label | escape }}">
            {{ filter.label }}
          </button>
          {% assign shown = shown | plus: 1 %}
        {% endif %}
      {% endfor %}

    </div>
  </div>
</div>

<script>
// Script for the chip that automatically open the search and discovery filters or facets.
document.addEventListener('DOMContentLoaded', () => {
  const scrollContainer = document.querySelector('.mobile-filter-scroll');
  let isDown = false, startX, scrollLeft, isDragging = false;

  scrollContainer.addEventListener('mousedown', e => {
    isDown = true;
    startX = e.pageX - scrollContainer.offsetLeft;
    scrollLeft = scrollContainer.scrollLeft;
  });

  scrollContainer.addEventListener('mouseup', () => {
    isDown = false;
    setTimeout(() => isDragging = false, 50);
  });

  scrollContainer.addEventListener('mousemove', e => {
    if (!isDown) return;
    e.preventDefault();
    const x = e.pageX - scrollContainer.offsetLeft;
    const walk = (x - startX) * 2;
    if (Math.abs(walk) > 5) isDragging = true;
    scrollContainer.scrollLeft = scrollLeft - walk;
  });

  document.querySelectorAll('.filter-chip').forEach(chip => {
    chip.addEventListener('click', e => {
      e.preventDefault();

      if (isDragging) {
        isDragging = false;
        return;
      }

      const filterName = chip.dataset.filter?.toLowerCase();

      const openBtn = document.querySelector('.mobile-facets__open');
      if (openBtn) openBtn.click();

      setTimeout(() => {
        const summaries = document.querySelectorAll('.mobile-facets__summary');

        summaries.forEach(summary => {
          const text = summary.innerText.toLowerCase();

          if (text.includes(filterName)) {
            summary.click();
            summary.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      }, 400);
    });
  });
});
</script>


<script>
  
  // Script for icon control (sorting columns view)

      document.addEventListener('DOMContentLoaded', () => {
        if (window.innerWidth > 768) return;

        const grid = document.querySelector('.main-product-grid');
        const buttons = document.querySelectorAll('.view-btn');

        if (!grid || !buttons.length) return;

        grid.classList.remove('grid-1');

        buttons.forEach(btn => {
          btn.classList.remove('active');
          if (btn.dataset.view === 'grid') {
            btn.classList.add('active');
          }

          btn.addEventListener('click', () => {
            buttons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            if (btn.dataset.view === 'single') {
              grid.classList.add('grid-1');
            } else {
              grid.classList.remove('grid-1');
            }
          });
        });
      });

</script>

