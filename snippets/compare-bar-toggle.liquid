{%- comment -%}
  compare-toggle-button.liquid

  Drop this into your product card template wherever you want the
  "Add to Compare" control to appear (e.g. inside collection-grid,
  static-product-grid, or wherever your product cards render), with:

    {% render 'compare-toggle-button', product: product %}

  Requires compare-bar.liquid to already be included on the page (for
  window.CompareManager) — that's rendered once site-wide in theme.liquid.
{%- endcomment -%}

<button
  type="button"
  class="cmp-toggle"
  data-compare-handle="{{ product.handle }}"
  data-compare-title="{{ product.title | escape }}"
  aria-pressed="false"
>
  <span class="cmp-toggle__icon" aria-hidden="true">
    <svg class="cmp-toggle__icon-add" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M5 12h14"/>
    </svg>
    <svg class="cmp-toggle__icon-added" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 6 9 17l-5-5"/>
    </svg>
  </span>
  <span class="cmp-toggle__label">
    <span class="cmp-toggle__label-add">Add to Compare</span>
    <span class="cmp-toggle__label-added">Added to Compare</span>
  </span>
</button>

<style>
  .cmp-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: 1px solid var(--color-border, #e0e0e0);
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-foreground, #1a1a1a);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .cmp-toggle:hover { background: #f5f5f2; }
  .cmp-toggle:disabled { opacity: 0.5; cursor: not-allowed; }

  .cmp-toggle__icon { width: 14px; height: 14px; flex-shrink: 0; }
  .cmp-toggle__icon svg { width: 100%; height: 100%; display: block; }
  .cmp-toggle__icon-added { display: none; }

  .cmp-toggle__label-added { display: none; }

  .cmp-toggle[aria-pressed="true"] {
    background: #1a1a1a;
    border-color: #1a1a1a;
    color: #fff;
  }
  .cmp-toggle[aria-pressed="true"] .cmp-toggle__icon-add { display: none; }
  .cmp-toggle[aria-pressed="true"] .cmp-toggle__icon-added { display: block; }
  .cmp-toggle[aria-pressed="true"] .cmp-toggle__label-add { display: none; }
  .cmp-toggle[aria-pressed="true"] .cmp-toggle__label-added { display: inline; }
</style>

<script>
  (function () {
    function syncButton(btn) {
      if (!window.CompareManager) return;
      var handle = btn.getAttribute('data-compare-handle');
      var selected = window.CompareManager.has(handle);
      btn.setAttribute('aria-pressed', selected ? 'true' : 'false');
      btn.disabled = !selected && window.CompareManager.isFull();
    }

    function syncAllButtons() {
      document.querySelectorAll('.cmp-toggle').forEach(syncButton);
    }

    function initCompareToggles() {
      document.querySelectorAll('.cmp-toggle:not([data-cmp-init])').forEach(function (btn) {
        btn.setAttribute('data-cmp-init', 'true');
        var handle = btn.getAttribute('data-compare-handle');
        var title = btn.getAttribute('data-compare-title');

        btn.addEventListener('click', function () {
          if (!window.CompareManager) return;
          if (window.CompareManager.has(handle)) {
            window.CompareManager.remove(handle);
          } else {
            window.CompareManager.add(handle, title);
          }
          syncButton(btn);
        });

        syncButton(btn);
      });
    }

    document.addEventListener('DOMContentLoaded', initCompareToggles);
    document.addEventListener('shopify:section:load', initCompareToggles);
    // Keep every button's checked/disabled state in sync when the
    // selection changes from anywhere (e.g. removed via the sticky bar) —
    // not gated by the init guard, since this must re-run every time.
    document.addEventListener('compare:render', syncAllButtons);
  })();
</script>
