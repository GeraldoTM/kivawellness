{% doc %}
  @prompt
    Add a clickable phone icon to the header that links to tel:1800945229. The icon should match the header's existing style and be visible on both mobile and desktop. It should display a phone/telephone SVG icon that when clicked, initiates a call to 1800 945 229.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-phone-icon-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .ai-phone-icon-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
    text-decoration: none;
    transition: all 0.3s ease;
    padding: {{ block.settings.padding }}px;
  }

  .ai-phone-icon-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.icon_hover_color }};
    transform: scale({{ block.settings.hover_scale }});
  }

  .ai-phone-icon-link-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    stroke-width: {% if block.settings.icon_stroke == 'thin' %}1.5{% elsif block.settings.icon_stroke == 'heavy' %}2.5{% else %}2{% endif %};
  }

  @media screen and (max-width: 749px) {
    .ai-phone-icon-link-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-phone-icon-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <a 
    href="tel:{{ block.settings.phone_number }}" 
    class="ai-phone-icon-link-{{ ai_gen_id }}"
    aria-label="Call {{ block.settings.phone_number }}"
  >
    <svg 
      xmlns="http://www.w3.org/2000/svg" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke="currentColor" 
      stroke-linecap="round" 
      stroke-linejoin="round"
    >
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
  </a>
</div>

{% schema %}
{
  "name": "Phone icon",
  "settings": [
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "1800945229",
      "info": "Enter the phone number without spaces or special characters"
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Desktop size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Mobile size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "icon_stroke",
      "label": "Stroke weight",
      "options": [
        {
          "value": "thin",
          "label": "Thin"
        },
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "heavy",
          "label": "Heavy"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "icon_hover_color",
      "label": "Hover color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Hover effect"
    },
    {
      "type": "range",
      "id": "hover_scale",
      "label": "Hover scale",
      "min": 1,
      "max": 1.5,
      "step": 0.1,
      "default": 1.1
    }
  ],
  "presets": [
    {
      "name": "Phone icon"
    }
  ],
  "tag": null
}
{% endschema %}
