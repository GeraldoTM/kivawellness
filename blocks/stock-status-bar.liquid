{%- liquid
  assign raw_value = closest.product.metafields.custom.stock_status_line_two
  assign items = raw_value | split: ','
-%}

{%- if raw_value != blank -%}
  <style>
    .stock-status-bar-{{ block.id }} {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      background: {{ block.settings.background_color | default: '#ffffff' }};
      color: {{ block.settings.text_color | default: '#120d07' }};
      font-size: {{ block.settings.text_size | default: 14 }}px;
      border-radius: {{ block.settings.border_radius | default: 6 }}px;
      padding: 10px;
      {%- if block.settings.width == 'custom' -%}
        width: {{ block.settings.custom_width | default: 100 }}%;
      {%- elsif block.settings.width == 'fit-content' -%}
        width: fit-content;
      {%- else -%}
        width: 100%;
      {%- endif -%}
      box-sizing: border-box;
    }
    .stock-status-bar-{{ block.id }}::-webkit-scrollbar { display: none; }
    .stock-status-bar-{{ block.id }} .stock-status-bar__item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .stock-status-bar-{{ block.id }} .stock-status-bar__icon {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      color: {{ block.settings.icon_color | default: '#2e7d32' }};
    }

    @media (max-width: 768px){
      .stock-status-bar-{{ block.id }} {display: block; padding:5px;}
    }
  </style>

  <div class="stock-status-bar-{{ block.id }}" {{ block.shopify_attributes }}>
    {%- for item in items -%}
      <span class="stock-status-bar__item">
        {% comment %}
          <svg
            class="stock-status-bar__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 6 9 17l-5-5"/>
          </svg>
        {% endcomment %}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="-0.5 -0.5 16 16"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="stock-status-bar__icon"
          height="20"
          width="20"
        >
          <desc>
            Check Circle Streamline Icon: https://streamlinehq.com
          </desc>
          <path d="M13.75 6.925V7.5a6.25 6.25 0 1 1 -3.70625 -5.7125" stroke-width="1"></path>
          <path d="M13.75 2.5 7.5 8.75625l-1.875 -1.875" stroke-width="1"></path>
        </svg>
        {{ item | strip }}
      </span>
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Stock status bar",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#120d07" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#2e7d32" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    { "type": "header", "content": "Width" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "fit-content", "label": "Fit content" },
        { "value": "fill", "label": "Full width" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Stock status bar"
    }
  ]
}
{% endschema %}
