{%- doc -%}
  Renders a tabbed content block (Benefits / Product Details / Best For /
  Bonuses) sourced from a single product_tab_items metaobject entry,
  referenced via the product's custom.product_tabs metafield.
{%- enddoc -%}

{% liquid
  assign product = closest.product
  assign tabs_entry = product.metafields.custom.product_tabs.value
  assign scope = 'pt-' | append: block.id
%}

{% if tabs_entry %}
  {% liquid
    assign tab_1_label = block.settings.tab_1_label
    assign tab_2_label = block.settings.tab_2_label
    assign tab_3_label = block.settings.tab_3_label
    assign tab_4_label = block.settings.tab_4_label

    # Matches your actual metaobject fields: Benefits, Product Details, Best For, Bonuses
    assign tab_1_content = tabs_entry.benefits
    assign tab_2_content = tabs_entry.product_details
    assign tab_3_content = tabs_entry.best_for
    assign tab_4_content = tabs_entry.bonuses
  %}

  <div class="{{ scope }} product-tabs" {{ block.shopify_attributes }}>
    <div class="{{ scope }}__buttons product-tabs__buttons" role="tablist">
      {% if tab_1_content != blank %}
        <button type="button" class="{{ scope }}__button product-tabs__button is-active" data-tab-index="0" role="tab" aria-selected="true">
          <span>{{ tab_1_label | default: 'Benefits' }}</span>
        </button>
      {% endif %}
      {% if tab_2_content != blank %}
        <button type="button" class="{{ scope }}__button product-tabs__button" data-tab-index="1" role="tab" aria-selected="false">
          <span>{{ tab_2_label | default: 'Product Details' }}</span>
        </button>
      {% endif %}
      {% if tab_3_content != blank %}
        <button type="button" class="{{ scope }}__button product-tabs__button" data-tab-index="2" role="tab" aria-selected="false">
          <span>{{ tab_3_label | default: 'Best For' }}</span>
        </button>
      {% endif %}
      {% if tab_4_content != blank %}
        <button type="button" class="{{ scope }}__button product-tabs__button" data-tab-index="3" role="tab" aria-selected="false">
          <span>{{ tab_4_label | default: 'Bonuses' }}</span>
        </button>
      {% endif %}
    </div>

    <div class="{{ scope }}__underline-track product-tabs__underline-track">
      <div class="{{ scope }}__underline product-tabs__underline" data-tab-underline></div>
    </div>

    <div class="{{ scope }}__panels product-tabs__panels">
      {% if tab_1_content != blank %}
        <div class="{{ scope }}__panel product-tabs__panel is-active" data-tab-panel="0">
          <div class="{{ scope }}__rich-text product-tabs__rich-text">{{ tab_1_content | metafield_tag }}</div>
        </div>
      {% endif %}
      {% if tab_2_content != blank %}
        <div class="{{ scope }}__panel product-tabs__panel" data-tab-panel="1">
          <div class="{{ scope }}__rich-text product-tabs__rich-text">{{ tab_2_content | metafield_tag }}</div>
        </div>
      {% endif %}
      {% if tab_3_content != blank %}
        <div class="{{ scope }}__panel product-tabs__panel" data-tab-panel="2">
          <div class="{{ scope }}__rich-text product-tabs__rich-text">{{ tab_3_content | metafield_tag }}</div>
        </div>
      {% endif %}
      {% if tab_4_content != blank %}
        <div class="{{ scope }}__panel product-tabs__panel" data-tab-panel="3">
          <div class="{{ scope }}__rich-text product-tabs__rich-text">{{ tab_4_content | metafield_tag }}</div>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .product-tabs {
    --tabs-accent: #C8A8E9; /* lilac */
  }

  .product-tabs__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--padding-lg, 24px);
  }

  .product-tabs__button {
    background: none;
    border: none;
    padding: 0 0 var(--padding-sm, 12px);
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.55);
    transition: color 0.2s ease;
  }

  .product-tabs__button:hover {
    color: var(--color-foreground, currentColor);
  }

  .product-tabs__button.is-active {
    color: var(--tabs-accent);
  }

  .product-tabs__underline-track {
    position: relative;
    height: 1px;
    background: rgb(var(--color-foreground-rgb, 0 0 0) / 0.12);
    margin-bottom: var(--padding-lg, 24px);
  }

  .product-tabs__underline {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    background: var(--tabs-accent);
    transition: transform 0.3s ease, width 0.3s ease;
  }

  .product-tabs__panel {
    display: none;
  }

  .product-tabs__panel.is-active {
    display: block;
  }

  .product-tabs__rich-text ul {
    margin: 0;
    padding-left: 1.2em;
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: disc;
  }

  .product-tabs__rich-text li {
    line-height: 1.5;
  }

  .product-tabs__rich-text a {
    color: var(--tabs-accent);
    text-decoration: underline;
  }

  .product-tabs__rich-text p {
    margin: 0 0 8px;
  }

  .product-tabs__rich-text p:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

<script>
  (function () {
    function initProductTabs(root) {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      var buttons = root.querySelectorAll('[data-tab-index]');
      var panels = root.querySelectorAll('[data-tab-panel]');
      var underline = root.querySelector('[data-tab-underline]');

      function moveUnderline(button) {
        if (!underline || !button) return;
        underline.style.width = button.offsetWidth + 'px';
        underline.style.transform = 'translateX(' + button.offsetLeft + 'px)';
      }

      function activateTab(index) {
        buttons.forEach(function (btn) {
          var isActive = btn.dataset.tabIndex === String(index);
          btn.classList.toggle('is-active', isActive);
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
          if (isActive) moveUnderline(btn);
        });

        panels.forEach(function (panel) {
          panel.classList.toggle('is-active', panel.dataset.tabPanel === String(index));
        });
      }

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          activateTab(btn.dataset.tabIndex);
        });
      });

      var firstActive = root.querySelector('.is-active[data-tab-index]');
      if (firstActive) {
        requestAnimationFrame(function () {
          moveUnderline(firstActive);
        });
      }

      window.addEventListener('resize', function () {
        var current = root.querySelector('.is-active[data-tab-index]');
        if (current) moveUnderline(current);
      });
    }

    function init() {
      document.querySelectorAll('.product-tabs').forEach(initProductTabs);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

{% schema %}
{
  "name": "Product Tabs",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Tab labels"
    },
    { "type": "text", "id": "tab_1_label", "label": "Tab 1 label", "default": "Benefits" },
    { "type": "text", "id": "tab_2_label", "label": "Tab 2 label", "default": "Product Details" },
    { "type": "text", "id": "tab_3_label", "label": "Tab 3 label", "default": "Best For" },
    { "type": "text", "id": "tab_4_label", "label": "Tab 4 label", "default": "Bonuses" }
  ],
  "presets": [
    { "name": "Product Tabs" }
  ]
}
{% endschema %}