{% liquid
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant
  assign has_compare = false
  if variant.compare_at_price > variant.price
    assign has_compare = true
  endif
%}

{%- if product != blank -%}
  <div class="custom-price-{{ block.id }}" {{ block.shopify_attributes }}>
    {%- if has_compare -%}
      <span class="custom-price__compare">{{ variant.compare_at_price | money }}</span>
      <span class="custom-price__sale">{{ variant.price | money }}</span>
    {%- else -%}
      <span class="custom-price__regular">{{ variant.price | money }}</span>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .custom-price-{{ block.id }} {
    font-size: 16px;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .custom-price__compare {
    color: #000000;
    text-decoration: line-through;
    opacity: 0.7;
  }

  .custom-price__sale {
    color: #d9603b;
    font-weight: 600;
  }

  .custom-price__regular {
    color: #000000;
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Price Modified",
  "tag": null,
  "settings": [],
  "presets": [{ "name": "Price Modified" }]
}
{% endschema %}
