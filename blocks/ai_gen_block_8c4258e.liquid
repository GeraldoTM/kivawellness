{% doc %}
  @prompt
    Create an editorial style Customer reviews layout that scrolls sideways , Add a diagonal gradient background to the reviews using these two colours #dfd7ed #c3cdc5, I meant behind each review, not the review block. Also can the gradient merge both colours one from the bottom left corner, one from right top - blening in centre, Great. Make the customer name icon a product image that I can select and add
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    display: block;
  }

  .ai-reviews-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-reviews-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px 0;
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
  }

  .ai-reviews-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-reviews-scroll-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.scrollbar_color }} transparent;
  }

  .ai-reviews-scroll-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 8px;
  }

  .ai-reviews-scroll-wrapper-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: transparent;
  }

  .ai-reviews-scroll-wrapper-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background-color: {{ block.settings.scrollbar_color }};
    border-radius: 4px;
  }

  .ai-reviews-grid-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    padding: 20px 0;
  }

  .ai-review-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background: linear-gradient(to top right, #c3cdc5 0%, #dfd7ed 100%);
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-review-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-review-avatar-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
    background-color: {{ block.settings.avatar_background }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-review-avatar-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-review-avatar-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-review-avatar-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-review-author-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-review-author-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_name_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px 0;
  }

  .ai-review-date-{{ ai_gen_id }} {
    font-size: {{ block.settings.date_size }}px;
    color: {{ block.settings.date_color }};
    margin: 0;
  }

  .ai-review-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-review-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-review-star-empty-{{ ai_gen_id }} {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-review-product-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-review-product-image-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    border-radius: {{ block.settings.product_image_radius }}px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .ai-review-product-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-review-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-review-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_mobile }}px;
    }

    .ai-reviews-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-reviews-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<customer-reviews-{{ ai_gen_id }} class="ai-reviews-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
    <div class="ai-reviews-header-{{ ai_gen_id }}">
      {% if block.settings.section_title != blank %}
        <h2 class="ai-reviews-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      {% endif %}
      {% if block.settings.section_subtitle != blank %}
        <div class="ai-reviews-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</div>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-reviews-scroll-wrapper-{{ ai_gen_id }}">
    <div class="ai-reviews-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign review_enabled_key = 'review_' | append: i | append: '_enabled'
          assign author_name_key = 'review_' | append: i | append: '_author_name'
          assign author_image_key = 'review_' | append: i | append: '_author_image'
          assign date_key = 'review_' | append: i | append: '_date'
          assign rating_key = 'review_' | append: i | append: '_rating'
          assign text_key = 'review_' | append: i | append: '_text'
          assign product_key = 'review_' | append: i | append: '_product'

          assign review_enabled = block.settings[review_enabled_key]
          assign author_name = block.settings[author_name_key]
          assign author_image = block.settings[author_image_key]
          assign review_date = block.settings[date_key]
          assign rating = block.settings[rating_key]
          assign review_text = block.settings[text_key]
          assign product = block.settings[product_key]
        %}

        {% if review_enabled %}
          <div class="ai-review-card-{{ ai_gen_id }}">
            <div class="ai-review-header-{{ ai_gen_id }}">
              <div class="ai-review-avatar-{{ ai_gen_id }}">
                {% if author_image %}
                  <img
                    src="{{ author_image | image_url: width: 100 }}"
                    alt="{{ author_name | escape }}"
                    class="ai-review-avatar-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ block.settings.avatar_size }}"
                    height="{{ block.settings.avatar_size }}"
                  >
                {% else %}
                  <div class="ai-review-avatar-placeholder-{{ ai_gen_id }}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                  </div>
                {% endif %}
              </div>
              <div class="ai-review-author-info-{{ ai_gen_id }}">
                <h3 class="ai-review-author-name-{{ ai_gen_id }}">
                  {% if author_name != blank %}
                    {{ author_name }}
                  {% else %}
                    Anonymous
                  {% endif %}
                </h3>
                {% if review_date != blank %}
                  <p class="ai-review-date-{{ ai_gen_id }}">{{ review_date }}</p>
                {% endif %}
              </div>
            </div>

            <div class="ai-review-stars-{{ ai_gen_id }}">
              {% for star in (1..5) %}
                <svg class="ai-review-star-{{ ai_gen_id }} {% if star > rating %}ai-review-star-empty-{{ ai_gen_id }}{% endif %}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
            </div>

            {% if review_text != blank %}
              <p class="ai-review-text-{{ ai_gen_id }}">{{ review_text }}</p>
            {% endif %}

            {% if product != blank and block.settings.show_product_info %}
              <div class="ai-review-product-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 120 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-review-product-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="60"
                    height="60"
                  >
                {% endif %}
                <div class="ai-review-product-info-{{ ai_gen_id }}">
                  <h4 class="ai-review-product-title-{{ ai_gen_id }}">{{ product.title }}</h4>
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</customer-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomerReviews{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.scrollWrapper = this.querySelector('.ai-reviews-scroll-wrapper-{{ ai_gen_id }}');
        this.setupScrollBehavior();
      }

      setupScrollBehavior() {
        if (!this.scrollWrapper) return;

        let isDown = false;
        let startX;
        let scrollLeft;

        this.scrollWrapper.addEventListener('mousedown', (e) => {
          isDown = true;
          this.scrollWrapper.style.cursor = 'grabbing';
          startX = e.pageX - this.scrollWrapper.offsetLeft;
          scrollLeft = this.scrollWrapper.scrollLeft;
        });

        this.scrollWrapper.addEventListener('mouseleave', () => {
          isDown = false;
          this.scrollWrapper.style.cursor = 'grab';
        });

        this.scrollWrapper.addEventListener('mouseup', () => {
          isDown = false;
          this.scrollWrapper.style.cursor = 'grab';
        });

        this.scrollWrapper.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.scrollWrapper.offsetLeft;
          const walk = (x - startX) * 2;
          this.scrollWrapper.scrollLeft = scrollLeft - walk;
        });

        this.scrollWrapper.style.cursor = 'grab';
      }
    }

    customElements.define('customer-reviews-{{ ai_gen_id }}', CustomerReviews{{ ai_gen_id }});
  })();
</script>

