{%- doc -%}
  Icon with Text — theme block. Static classes (no {{ block.id }}
  interpolation) — simple and easy to debug, but means two instances of
  this block with DIFFERENT color/size settings on the same page will
  visually collide (the later one wins). Fine for single use, or multiple
  copies that share the same styling with different text/icon.

  Icon library trimmed to just Truck for now. Icon (library, custom SVG,
  or image) + heading + description, fixed layout: icon left, text right.
{%- enddoc -%}

{% liquid
  assign has_link = false
  if block.settings.link != blank
    assign has_link = true
  endif

  assign wrapper_tag = 'div'
  if has_link
    assign wrapper_tag = 'a'
  endif

  assign has_icon = false
  if block.settings.custom_svg != blank or block.settings.image != blank or block.settings.icon != 'none'
    assign has_icon = true
  endif
%}

<{{ wrapper_tag }}
  class="icon-text"
  {% if has_link %}href="{{ block.settings.link }}"{% endif %}
  {{ block.shopify_attributes }}
>
  {%- if has_icon -%}
    <span class="icon-text__icon">
      {%- if block.settings.custom_svg != blank -%}
        {{ block.settings.custom_svg }}
      {%- elsif block.settings.image != blank -%}
        <img
          src="{{ block.settings.image | image_url: width: 200 }}"
          alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {%- else -%}
        {%- case block.settings.icon -%}
          {%- when 'truck' -%}
                 <svg viewBox="-0.5 -0.5 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" height = "30" width = "30">
                  <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M2.875 17.25a1.917 1.917 0 1 0 3.833 0 1.917 1.917 0 1 0-3.833 0ZM16.292 17.25a1.917 1.917 0 1 0 3.833 0 1.917 1.917 0 1 0-3.833 0Z"></path>
                  <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M2.875 17.25H1.437a.958.958 0 0 1-.958-.958v-3.82a.958.958 0 0 1 .402-.78l2.952-1.15.778-4.067a.958.958 0 0 1 .93-.725h3.563v-.958a.958.958 0 0 1 .959-.959h11.5a.958.958 0 0 1 .958.959v11.5a.958.958 0 0 1-.959.958h-1.437M6.708 17.25h9.584M9.104 5.75v9.583M.48 14.375h1.437M3.833 10.542h5.271"></path>
                </svg>
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
        {%- endcase -%}
      {%- endif -%}
    </span>
  {%- endif -%}

  <span class="icon-text__text">
    {%- if block.settings.heading != blank -%}
      <span class="icon-text__heading">{{ block.settings.heading }}</span>
    {%- endif -%}
    {%- if block.settings.description != blank -%}
      <span class="icon-text__description">{{ block.settings.description }}</span>
    {%- endif -%}
  </span>
</{{ wrapper_tag }}>

{% stylesheet %}
  /* Static classes — no per-instance IDs. Fixed layout: icon left, text
     right, icon fixed at 20px. */
  .icon-text {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    background: {{ block.settings.background_color | default: 'transparent' }};
    border-radius: {{ block.settings.corner_radius }}px;
    padding-block: {{ block.settings.padding_vertical }}px;
    padding-inline: {{ block.settings.padding_horizontal }}px;
    {% if block.settings.border_width > 0 %}
      border: {{ block.settings.border_width }}px solid {{ block.settings.border_color | default: '#e0e0e0' }};
    {% endif %}
  }

  .icon-text__icon {
    display: block !important;
    width: 20px !important;
    height: 20px !important;
    flex-shrink: 0;
    color: {{ block.settings.icon_color | default: 'currentColor' }};
  }
  .icon-text__icon img,
  .icon-text__icon svg {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: contain;
  }

  .icon-text__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    text-align: left;
  }

  .icon-text__heading {
    font-family: {{ block.settings.heading_font }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color | default: 'inherit' }};
    line-height: 1.3;
  }

  .icon-text__description {
    font-family: {{ block.settings.description_font }};
    font-size: {{ block.settings.description_size }}px;
    font-weight: 400;
    color: {{ block.settings.description_color | default: 'inherit' }};
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .icon-text__heading {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }
    .icon-text__description {
      font-size: {{ block.settings.description_size_mobile }}px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Icon with Text",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Icon" },
    {
      "type": "textarea",
      "id": "custom_svg",
      "label": "Custom SVG code",
      "info": "Paste your own SVG markup here. Takes priority over both the icon library and the image below."
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon (library)",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "truck", "label": "Truck" }
      ],
      "default": "truck"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom icon image",
      "info": "Used if no custom SVG is pasted above. Overrides the icon library selection."
    },
    { "type": "color", "id": "icon_color", "label": "Icon color" },

    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Free shipping" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>On all orders over $100</p>" },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "var(--font-body--family)", "label": "Body" },
        { "value": "var(--font-subheading--family)", "label": "Subheading" },
        { "value": "var(--font-heading--family)", "label": "Heading" },
        { "value": "var(--font-accent--family)", "label": "Accent" }
      ],
      "default": "var(--font-body--family)"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    { "type": "color", "id": "heading_color", "label": "Heading color" },
    {
      "type": "select",
      "id": "description_font",
      "label": "Description font",
      "options": [
        { "value": "var(--font-body--family)", "label": "Body" },
        { "value": "var(--font-subheading--family)", "label": "Subheading" },
        { "value": "var(--font-heading--family)", "label": "Heading" },
        { "value": "var(--font-accent--family)", "label": "Accent" }
      ],
      "default": "var(--font-body--family)"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size (desktop)",
      "min": 8,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "label": "Description size (mobile)",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    { "type": "color", "id": "description_color", "label": "Description color" },

    { "type": "header", "content": "Link (optional)" },
    { "type": "url", "id": "link", "label": "Link", "info": "Makes the whole block clickable." },

    { "type": "header", "content": "Container style" },
    { "type": "color", "id": "background_color", "label": "Background color" },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    { "type": "color", "id": "border_color", "label": "Border color" },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Padding (top/bottom)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding (left/right)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Icon with Text",
      "settings": { "heading": "Free shipping", "icon": "truck" }
    }
  ]
}
{% endschema %}
