{% liquid
  assign heading_is_custom = false
  if section.settings.heading_type_preset == 'custom'
    assign heading_is_custom = true
  endif
%}

<div
  class="tcf-{{ section.id }}"
  style="
    --tcf-gap: {{ section.settings.column_gap }}px;
    --tcf-pad-block-start: {{ section.settings.padding_top }}px;
    --tcf-pad-block-end: {{ section.settings.padding_bottom }}px;
    {% if section.settings.background_color != blank %}--tcf-bg: {{ section.settings.background_color }};{% endif %}
  "
>
  <div class="tcf-{{ section.id }}__inner">
    <div class="tcf-{{ section.id }}__grid">

      <!-- Column 1: heading + paragraph + blocks -->
      <div class="tcf-{{ section.id }}__col tcf-{{ section.id }}__col--content tcf-{{ section.id }}__col--align-{{ section.settings.column_1_alignment }}">
        {% if section.settings.heading != blank %}
          <h2
            class="tcf-{{ section.id }}__heading{% if heading_is_custom %} tcf-{{ section.id }}__heading--custom{% endif %}"
            style="
              {% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}
              {% if heading_is_custom %}
                font-family: {{ section.settings.heading_font }};
                font-size: {{ section.settings.heading_font_size_mobile }}px;
                {% if section.settings.heading_case == 'uppercase' %}text-transform: uppercase;{% endif %}
              {% endif %}
            "
          >
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.paragraph != blank %}
          <div
            class="tcf-{{ section.id }}__paragraph"
            style="
              {% if section.settings.paragraph_color != blank %}color: {{ section.settings.paragraph_color }};{% endif %}
              font-size: {{ section.settings.paragraph_font_size_mobile }}px;
            "
          >
            {{ section.settings.paragraph }}
          </div>
        {% endif %}

        <div class="tcf-{{ section.id }}__blocks">
          {% content_for 'blocks' %}
        </div>
      </div>

      <!-- Column 2: middle, image or video -->
      <div class="tcf-{{ section.id }}__col tcf-{{ section.id }}__col--media tcf-{{ section.id }}__col--aspect-{{ section.settings.middle_aspect_ratio | replace: '/', '-' }}">
        {% if section.settings.middle_media_type == 'video' %}
          {% if section.settings.middle_video != blank %}
            {{
              section.settings.middle_video
              | video_tag:
                image_size: '1200x',
                autoplay: section.settings.middle_video_autoplay,
                loop: section.settings.middle_video_loop,
                muted: true,
                controls: false,
                class: 'tcf-media'
            }}
          {% elsif section.settings.middle_video_url != blank %}
            <div class="tcf-media tcf-media--embed">
              <iframe
                src="{{ section.settings.middle_video_url }}?rel=0"
                title="Video"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          {% else %}
            <div class="tcf-media tcf-media--placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
          {% endif %}
        {% else %}
          {% if section.settings.middle_image != blank %}
            {{
              section.settings.middle_image
              | image_url: width: 1200
              | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', class: 'tcf-media', alt: section.settings.heading
            }}
          {% else %}
            <div class="tcf-media tcf-media--placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
          {% endif %}
        {% endif %}
      </div>

      <!-- Column 3: right, image or video -->
      <div class="tcf-{{ section.id }}__col tcf-{{ section.id }}__col--media tcf-{{ section.id }}__col--aspect-{{ section.settings.right_aspect_ratio | replace: '/', '-' }}">
        {% if section.settings.right_media_type == 'video' %}
          {% if section.settings.right_video != blank %}
            {{
              section.settings.right_video
              | video_tag:
                image_size: '1200x',
                autoplay: section.settings.right_video_autoplay,
                loop: section.settings.right_video_loop,
                muted: true,
                controls: false,
                class: 'tcf-media'
            }}
          {% elsif section.settings.right_video_url != blank %}
            <div class="tcf-media tcf-media--embed">
              <iframe
                src="{{ section.settings.right_video_url }}?rel=0"
                title="Video"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          {% else %}
            <div class="tcf-media tcf-media--placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
          {% endif %}
        {% else %}
          {% if section.settings.right_image != blank %}
            {{
              section.settings.right_image
              | image_url: width: 1200
              | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', class: 'tcf-media', alt: section.settings.heading
            }}
          {% else %}
            <div class="tcf-media tcf-media--placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
          {% endif %}
        {% endif %}
      </div>

    </div>
  </div>
</div>

<style>
  .tcf-{{ section.id }} {
    background: var(--tcf-bg, transparent);
    padding-block: var(--tcf-pad-block-start, 48px) var(--tcf-pad-block-end, 48px);
  }

  .tcf-{{ section.id }}__inner {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .tcf-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--tcf-gap, 32px);
  }

  @media screen and (min-width: 750px) {
    .tcf-{{ section.id }}__grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: stretch;
    }
  }

  .tcf-{{ section.id }}__col--content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
  }
  .tcf-{{ section.id }}__col--align-left { text-align: left; align-items: flex-start; }
  .tcf-{{ section.id }}__col--align-center { text-align: center; align-items: center; }
  .tcf-{{ section.id }}__col--align-right { text-align: right; align-items: flex-end; }

  .tcf-{{ section.id }}__heading {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .tcf-{{ section.id }}__heading--custom {
    font-weight: 600;
  }

  .tcf-{{ section.id }}__paragraph {
    line-height: 1.5;
  }
  .tcf-{{ section.id }}__paragraph p {
    margin: 0 0 0.75em;
  }
  .tcf-{{ section.id }}__paragraph p:last-child {
    margin-bottom: 0;
  }

  .tcf-{{ section.id }}__blocks {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }

  .tcf-{{ section.id }}__col--media {
    width: 100%;
  }

  .tcf-media,
  .tcf-media--placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: 8px;
    background: #f2f2f2;
  }

  .tcf-{{ section.id }}__col--aspect-1-1 .tcf-media,
  .tcf-{{ section.id }}__col--aspect-1-1 .tcf-media--placeholder,
  .tcf-{{ section.id }}__col--aspect-1-1 .tcf-media--embed {
    aspect-ratio: 1 / 1;
  }
  .tcf-{{ section.id }}__col--aspect-3-4 .tcf-media,
  .tcf-{{ section.id }}__col--aspect-3-4 .tcf-media--placeholder,
  .tcf-{{ section.id }}__col--aspect-3-4 .tcf-media--embed {
    aspect-ratio: 3 / 4;
  }
  .tcf-{{ section.id }}__col--aspect-4-3 .tcf-media,
  .tcf-{{ section.id }}__col--aspect-4-3 .tcf-media--placeholder,
  .tcf-{{ section.id }}__col--aspect-4-3 .tcf-media--embed {
    aspect-ratio: 4 / 3;
  }
  .tcf-{{ section.id }}__col--aspect-16-9 .tcf-media,
  .tcf-{{ section.id }}__col--aspect-16-9 .tcf-media--placeholder,
  .tcf-{{ section.id }}__col--aspect-16-9 .tcf-media--embed {
    aspect-ratio: 16 / 9;
  }

  .tcf-media--embed {
    position: relative;
    overflow: hidden;
  }
  .tcf-media--embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .tcf-media--placeholder svg {
    width: 100%;
    height: 100%;
  }

  @media screen and (min-width: 750px) {
    .tcf-{{ section.id }}__heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }
    .tcf-{{ section.id }}__paragraph {
      font-size: {{ section.settings.paragraph_font_size_desktop }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Three Column Feature",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Feature heading" },
    {
      "type": "select",
      "id": "heading_type_preset",
      "label": "Preset",
      "options": [
        { "value": "h2", "label": "Default (H2)" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Font",
      "options": [
        { "value": "var(--font-body--family)", "label": "Body" },
        { "value": "var(--font-subheading--family)", "label": "Subheading" },
        { "value": "var(--font-heading--family)", "label": "Heading" },
        { "value": "var(--font-accent--family)", "label": "Accent" }
      ],
      "default": "var(--font-heading--family)",
      "visible_if": "{{ section.settings.heading_type_preset == 'custom' }}"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Size (mobile)",
      "min": 14,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.heading_type_preset == 'custom' }}"
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "label": "Size (desktop)",
      "min": 18,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.heading_type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "Case",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.heading_type_preset == 'custom' }}"
    },
    { "type": "color", "id": "heading_color", "label": "Color" },

    { "type": "header", "content": "Paragraph" },
    { "type": "richtext", "id": "paragraph", "label": "Paragraph", "default": "<p>Add supporting copy here.</p>" },
    { "type": "color", "id": "paragraph_color", "label": "Color" },
    {
      "type": "range",
      "id": "paragraph_font_size_mobile",
      "label": "Size (mobile)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "paragraph_font_size_desktop",
      "label": "Size (desktop)",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    { "type": "header", "content": "Column 1 layout" },
    {
      "type": "select",
      "id": "column_1_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },

    { "type": "header", "content": "Middle column" },
    {
      "type": "select",
      "id": "middle_media_type",
      "label": "Content type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "middle_image",
      "label": "Image",
      "visible_if": "{{ section.settings.middle_media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "middle_video",
      "label": "Video (uploaded)",
      "visible_if": "{{ section.settings.middle_media_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "middle_video_url",
      "label": "Video URL (fallback)",
      "info": "Used only if no video is uploaded above (e.g. a YouTube or Vimeo link).",
      "visible_if": "{{ section.settings.middle_media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "middle_video_autoplay",
      "label": "Autoplay (muted)",
      "default": true,
      "visible_if": "{{ section.settings.middle_media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "middle_video_loop",
      "label": "Loop",
      "default": true,
      "visible_if": "{{ section.settings.middle_media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "middle_aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/3", "label": "Standard (4:3)" },
        { "value": "16/9", "label": "Wide (16:9)" }
      ],
      "default": "1/1"
    },

    { "type": "header", "content": "Right column" },
    {
      "type": "select",
      "id": "right_media_type",
      "label": "Content type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Image",
      "visible_if": "{{ section.settings.right_media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "right_video",
      "label": "Video (uploaded)",
      "visible_if": "{{ section.settings.right_media_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "right_video_url",
      "label": "Video URL (fallback)",
      "info": "Used only if no video is uploaded above (e.g. a YouTube or Vimeo link).",
      "visible_if": "{{ section.settings.right_media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "right_video_autoplay",
      "label": "Autoplay (muted)",
      "default": true,
      "visible_if": "{{ section.settings.right_media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "right_video_loop",
      "label": "Loop",
      "default": true,
      "visible_if": "{{ section.settings.right_media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "right_aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/3", "label": "Standard (4:3)" },
        { "value": "16/9", "label": "Wide (16:9)" }
      ],
      "default": "1/1"
    },

    { "type": "header", "content": "Section layout" },
    { "type": "color", "id": "background_color", "label": "Background color" },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Three Column Feature"
    }
  ]
}
{% endschema %}
