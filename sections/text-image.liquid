{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} text-image section-{{ section.id }}-padding">
  <div
    class="text-image__inner{% if section.settings.image_position == 'left' %} text-image__inner--image-left{% endif %}"
    style="--text-image-min-height: {{ section.settings.min_height }}px;"
  >
    <div class="text-image__image-col">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1500 }}"
          srcset="
            {{ section.settings.image | image_url: width: 375 }} 375w,
            {{ section.settings.image | image_url: width: 750 }} 750w,
            {{ section.settings.image | image_url: width: 1100 }} 1100w,
            {{ section.settings.image | image_url: width: 1500 }} 1500w,
            {{ section.settings.image | image_url: width: 2000 }} 2000w
          "
          sizes="(max-width: 749px) 100vw, 50vw"
          alt="{{ section.settings.image.alt | escape | default: section.settings.heading | escape }}"
          class="text-image__image"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {%- else -%}
        <div class="text-image__image text-image__image--placeholder">
          {{ 'image' | placeholder_svg_tag: 'text-image__placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    <div class="text-image__text-col">
      <div class="text-image__text-inner" style="text-align: {{ section.settings.text_alignment }};">
        {%- if section.settings.heading != blank -%}
          <h3 class="text-image__heading">{{ section.settings.heading }}</h3>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="text-image__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="button button--secondary text-image__button"
          >
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .text-image {
    background-color: var(--color-background);
    color: rgb(var(--color-foreground-rgb));
  }

  .text-image__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    width: 100%;
    min-height: var(--text-image-min-height, 500px);
  }

  /* Default: text on the left (order 1), image on the right (order 2) */
  .text-image__text-col {
    order: 1;
  }

  .text-image__image-col {
    order: 2;
  }

  /* Reversed: image moves to the left, text moves to the right */
  .text-image__inner--image-left .text-image__image-col {
    order: 1;
  }

  .text-image__inner--image-left .text-image__text-col {
    order: 2;
  }

  .text-image__image-col,
  .text-image__text-col {
    flex: 1 1 50%;
    min-width: 0;
    position: relative;
  }

  /* Image always fills its entire column, top to bottom, regardless of
     its natural aspect ratio or how tall the text column ends up being
     (flex align-items: stretch keeps both columns the same height). */
  .text-image__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .text-image__image--placeholder {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .text-image__image--placeholder .text-image__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .text-image__text-inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    padding: var(--padding-3xl, 48px);
    max-width: 560px;
    margin-inline: auto;
  }

  .text-image__heading {
    margin: 0 0 var(--gap-xl, 16px);
  }

  .text-image__text {
    font-size: var(--font-size--base);
    line-height: 160%;
  }

  .text-image__text p {
    margin: 0 0 var(--gap-xl, 16px);
  }

  .text-image__text p:last-child {
    margin-bottom: 0;
  }

  .text-image__button {
    display: inline-block;
    margin-top: var(--gap-xl, 24px);
    width: fit-content;
  }

  /* If text alignment is centered or right-aligned, the button follows
     along rather than staying pinned to the left. */
  .text-image__text-inner[style*='text-align: center'] .text-image__button {
    margin-inline: auto;
  }

  .text-image__text-inner[style*='text-align: right'] .text-image__button {
    margin-inline-start: auto;
  }

  /* Below 750px: stack into a single column. The image still shows
     first when "Image position" is set to Left, and last when set to
     Right, since flex order carries through into column direction. */
  @media screen and (max-width: 749px) {
    .text-image__inner {
      flex-direction: column;
      min-height: 0;
    }

    .text-image__image-col,
    .text-image__text-col {
      flex-basis: auto;
      width: 100%;
    }

    .text-image__image-col {
      min-height: 320px;
    }

    .text-image__image {
      position: static;
      width: 100%;
      height: 320px;
    }

    .text-image__text-inner {
      height: auto;
      padding: var(--padding-3xl, 32px) var(--padding-inline, 24px);
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Text with image",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Add a headline"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Use this text to describe products, share announcements, or welcome customers to your store.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Button (optional)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum section height",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Text with image"
    }
  ]
}
{% endschema %}
