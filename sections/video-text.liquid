{% assign values = section.settings %}
<style>
  .video-text-outer-wrapper{
    display: flex;
    align-items:center;
    justify-items:center;
  }
  
  .video-text-main-wrapper {
  max-width: 70rem;
  margin-inline: auto;
  margin-top: {{section.settings.padding_top | divided_by: 2 }}px;
  margin-bottom: {{section.settings.padding_bottom | divided_by: 2  }}px;
  padding: 12px;
  padding-top: 24px;
  gap: 12px;
  flex-direction: {% if values.reverse == true %}column-reverse{% else %} column {% endif %};
  text-align: center;
}
.video-text-main-wrapper > div {
  padding: 12px;
} 
  .video-text-main-wrapper .video-wrapper video{
    height: 390px;
    width: 100%;
    object-fit: contain;
    border-radius: 8px;
  }
  
.video-text-main-wrapper h2 {
  color: var(--stone);
  font-size: 24px;
  font-weight: 700;
  line-height: 120%;
  padding-bottom: 24px;
}
.video-text-main-wrapper .description, .video-text-main-wrapper .description * {
  color: #4f4540;
  font-size: 18px;
  line-height: 150%;
  padding-bottom: 24px;
}
.video-text-main-wrapper .btn-wrapper {
  display: flex;
  align-items: center;
  gap: 1rem;
}

  .video-text-main-wrapper .video-wrapper{
    padding: 0 !important;
    margin: 12px 12px 12px 0;
    border-radius: 5px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .video-text-main-wrapper .info-wrapper{
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

.video-text-main-wrapper .btn-wrapper .btn{
  width: 100%;
}
  
@media (min-width: 768px) {
  .video-text-main-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: {{section.settings.padding_top}}px;
    margin-bottom: {{section.settings.padding_bottom}}px;
    gap: 24px;
    padding: 24px;
    text-align: start;
  }
  {% if values.reverse == true %}
    .video-text-main-wrapper .info-wrapper{
      order: -1;
    }
  {% endif %}
  .video-text-main-wrapper h2{
    font-size: 32px;
  }
  .video-text-main-wrapper > div {
  padding: 24px;
  } 

  
.video-text-main-wrapper .btn-wrapper .btn{
  width: fit-content;
}
  .video-text-main-wrapper .video-wrapper{
    margin: 24px 24px 24px 0;
}
}

  @media (min-width: 1536px){
    .video-text-main-wrapper .video-wrapper video{
      height: auto;
      max-height: 500px;
    }
  }
</style>

<div class="video-text-outer-wrapper" style=" background-color: {{section.settings.background_color}};">
  <div class="flex video-text-main-wrapper">
 {% if values.video %}
   <div class="video-wrapper">
    {{ section.settings.video | video_tag:  image_size: '600x', height:390, autoplay: true, muted: true, loop: true}}
 </div>
  {% endif %}
   <div class="info-wrapper">
     <div>
     <h2>{{ values.heading }}</h2>
  </div>
  <div>
     <div class="description">{{ values.description }}</div>
     <div class="btn-wrapper">
        {% if values.button_text != "" %}
          <a href="{{ values.button_url }}" class="btn btn-secondary">{{ values.button_text }}</a>
       {% endif %}
     </div>
  </div>
  </div>
</div>
</div>


{% schema %}
  {
    "name": "Video-Text Block",
    "settings": [
        {
        "type": "video",
        "id": "video",
        "label": "Video"
      },
       {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Default Heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Default Description</p>"
        },
       {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Button"
        },
         {
          "type": "url",
          "id": "button_url",
          "label": "Button url"
        },
          {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color"
      },
      {
        "type":"checkbox",
        "id": "reverse",
        "label": "Reverse order"
      }
    ],
     "presets":[
        {"name": "Video-Text Block"}
      ]
  }
{% endschema %}
