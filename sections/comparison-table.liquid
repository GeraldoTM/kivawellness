{% comment %}
  comparison-table.liquid (section)
  Standalone page version of the comparison table. All actual markup
  now lives in snippets/comparison-table-content.liquid so the same
  table can also be rendered inside the "Compare button" theme block's
  flyout on product pages — sections can't be {% render %}'d directly,
  only snippets can, so the shared logic had to move there.
{% endcomment %}

{%- render 'comparison-table-content',
  products: section.settings.products,
  dom_id: section.id,
  heading: section.settings.heading,
  subheading: section.settings.subheading,
  column_label: section.settings.column_label,
  accent_color: section.settings.accent_color,
  accent_color_hover: section.settings.accent_color_hover
-%}

{% schema %}
{
  "name": "Comparison Table",
  "tag": "section",
  "class": "sauna-comparison-dynamic-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare Saunas" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "column_label", "label": "Left column label", "default": "Key Features" },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products to compare",
      "info": "Up to 4. Each product needs custom.comparison_enabled = true and a linked Comparison Profile to appear.",
      "limit": 4
    },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#c0392b" },
    { "type": "color", "id": "accent_color_hover", "label": "Accent color (hover)", "default": "#a93226" }
  ],
  "presets": [{ "name": "Comparison Table" }]
}
{% endschema %}
