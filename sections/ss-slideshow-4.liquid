{%- liquid
  assign padding_horizontal = section.settings.padding_horizontal
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign border_color = section.settings.border_color
  assign border_thickness = section.settings.border_thickness
  assign margin_top = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign background_color = section.settings.background_color
  assign background_gradient = section.settings.background_gradient
  assign full_width = section.settings.full_width
  assign content_width = section.settings.content_width

  assign use_controls = section.settings.use_controls
  assign controls = section.settings.controls
  assign autoplay = section.settings.autoplay
  assign autoplay_sec = section.settings.autoplay_sec

  assign image_radius = section.settings.image_radius
  assign image_custom = section.settings.image_custom
  assign image_custom_mobile = section.settings.image_custom_mobile
  assign image_height_mobile = section.settings.image_height_mobile
  assign image_height_desktop = section.settings.image_height_desktop
  assign hide_image = section.settings.hide_image

  assign arrow_color = section.settings.arrow_color
  assign arrow_hover_color = section.settings.arrow_hover_color
  assign border_btn_color = section.settings.border_btn_color
  assign border_btn_hover_color = section.settings.border_btn_hover_color
  assign bg_btn_color = section.settings.bg_btn_color
  assign bg_btn_hover_color = section.settings.bg_btn_hover_color
  assign dots_color = section.settings.dots_color
  assign dots_hover_color = section.settings.dots_hover_color
  assign numbers_color = section.settings.numbers_color
  assign numbers_bg_color = section.settings.numbers_bg_col
  assign numbers_border_color = section.settings.numbers_border_color
-%}

{% if section.blocks.first.settings.image_mobile != blank %}
  <link
    rel="preload"
    as="image"
    href="{{ section.blocks.first.settings.image_mobile | image_url: width: 800 }}"
    imagesrcset="
      {{ section.blocks.first.settings.image_mobile | image_url: width: 600 }} 600w,
      {{ section.blocks.first.settings.image_mobile | image_url: width: 800 }} 800w,
      {{ section.blocks.first.settings.image_mobile | image_url: width: 1200 }} 1200w
    "
    imagesizes="(max-width: 768px) 100vw, 1200px"
    fetchpriority="high"
  >
{% endif %}

{%- style -%}
  .section-{{ section.id }} {
    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
  }

  /* Transparent-header overlap: when this slideshow is the page's first
     section and a transparent header is active on this template (Horizon
     sets --transparent-header-offset-boolean to 1 in that case, 0
     otherwise), pull the slideshow up by exactly the header's height so
     the header floats over the image instead of sitting in a gap above
     it. This section never opted into Horizon's own .section/.spacing-style
     offset system, so without this rule there's nothing pushing it down —
     but there's also nothing guaranteed to pull it up flush either; this
     makes the overlap explicit and correct in both header states. */
  main > .shopify-section:first-child .section-{{ section.id }}.slide-show4 {
    margin-top: calc(var(--header-height, 0px) * var(--transparent-header-offset-boolean, 0) * -1);
  }

  .section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
  }

  /* ── Slider wrapper ── */
  .ns-slider-{{ section.id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ image_radius }}px;
  }

  /* ── Slides ── */
  .ns-slide-{{ section.id }} {
    position: absolute;
    inset: 0;
    opacity: 0;
    z-index: 0;
    transition: opacity 0.8s ease;
    min-height: 250px;
    box-sizing: border-box;
  }

  /* Height placeholder so the wrapper has dimensions */
  .ns-slide-{{ section.id }}.ns-active {
    opacity: 1;
    z-index: 1;
    position: relative; /* Active slide drives the wrapper height */
  }

  /* ── Image ── */
  .ns-slide-{{ section.id }} > img,
  .ns-slide-{{ section.id }} > svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ image_radius }}px;
  }

  /* ── Overlay ── */
  .ns-slide-{{ section.id }}::after {
    content: '';
    z-index: 1;
    position: absolute;
    inset: 0;
    border-radius: {{ image_radius }}px;
    pointer-events: none;
  }

  /* ── Content animation ── */
  .ns-slide-{{ section.id }} h2,
  .ns-slide-{{ section.id }} h4,
  .ns-slide-{{ section.id }} p,
  .ns-slide-{{ section.id }} a {
    transform: translateY(20px);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .ns-slide-{{ section.id }}.ns-active h2,
  .ns-slide-{{ section.id }}.ns-active h4 {
    transform: translateY(0);
    opacity: 1;
    transition: transform 0.3s ease 0.1s, opacity 0.3s ease 0.1s;
  }

  .ns-slide-{{ section.id }}.ns-active p {
    transform: translateY(0);
    opacity: 1;
    transition: transform 0.4s ease 0.15s, opacity 0.4s ease 0.15s;
  }

  .ns-slide-{{ section.id }}.ns-active a {
    transform: translateY(0);
    opacity: 1;
    transition: transform 0.5s ease 0.2s, opacity 0.5s ease 0.2s;
  }

  /* ── Desktop image toggle ── */
  .ns-desktop-image-{{ section.id }} { display: none !important; }

  /* ── Navigation buttons ── */
  .ns-btn-prev-{{ section.id }},
  .ns-btn-next-{{ section.id }} {
    position: absolute;
    z-index: 10;
    bottom: 20px;
    top: unset;
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid {{ border_btn_color }};
    transition: all 0.3s ease;
    cursor: pointer;
    background: transparent;
  }

  .ns-btn-prev-{{ section.id }}:hover,
  .ns-btn-next-{{ section.id }}:hover {
    border-color: {{ border_btn_hover_color }};
  }

  .ns-btn-next-{{ section.id }} { right: 20px; }
  .ns-btn-prev-{{ section.id }} { right: 80px; }

  .ns-btn-prev-{{ section.id }} svg { height: 12px; width: 10px; transform: rotate(90deg); }
  .ns-btn-next-{{ section.id }} svg { height: 12px; width: 10px; transform: rotate(-90deg); }

  .ns-btn-prev-{{ section.id }} svg path,
  .ns-btn-next-{{ section.id }} svg path {
    fill: {{ arrow_color }};
    transition: fill 0.3s ease;
  }

  .ns-btn-prev-{{ section.id }}:hover svg path,
  .ns-btn-next-{{ section.id }}:hover svg path { fill: {{ arrow_hover_color }}; }

  .ns-btn-prev-{{ section.id }}.ns-disabled,
  .ns-btn-next-{{ section.id }}.ns-disabled { opacity: 0.3; }

  /* ── Dots pagination ── */
  .ns-dots-{{ section.id }} {
    position: absolute;
    bottom: 20px;
    right: 20px;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0;
    width: fit-content;
  }

  .ns-dots-{{ section.id }} .ns-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1px solid {{ dots_color }};
    background: transparent;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .ns-dots-{{ section.id }} .ns-dot:not(:last-child) { margin-right: 20px; }

  .ns-dots-{{ section.id }} .ns-dot:hover { border-color: {{ dots_hover_color }}; }

  .ns-dots-{{ section.id }} .ns-dot.ns-active { background-color: {{ dots_color }}; }

  .ns-dots-{{ section.id }} .ns-dot.ns-active:hover { background-color: {{ dots_hover_color }}; }

  /* ── Numbers pagination ── */
  .ns-numbers-{{ section.id }} {
    position: absolute;
    right: 20px;
    bottom: 20px;
    top: unset;
    left: unset;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 20px;
    width: fit-content;
  }

  .ns-numbers-{{ section.id }} .ns-num-btn {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: 0.3s;
    padding: 0;
  }

  {% unless autoplay %}
    .ns-numbers-{{ section.id }} .ns-num-btn {
      width: 40px;
      height: 40px;
      background-color: {{ numbers_bg_color }};
      border: 2px solid {{ numbers_border_color }};
      border-radius: 50%;
    }
  {% endunless %}

  .ns-numbers-{{ section.id }} .ns-num-btn span.ns-label {
    font-weight: 500;
    color: {{ numbers_color }};
    font-size: 20px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  {% if autoplay %}
  .ns-numbers-{{ section.id }} .ns-progress-svg {
    transform: rotate(-90deg);
    display: block;
  }

  .ns-numbers-{{ section.id }} .ns-circle {
    fill: {{ numbers_bg_color }};
    stroke: {{ numbers_border_color }};
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 125.664px;
    stroke-dashoffset: 125.664px;
  }

  .ns-numbers-{{ section.id }} .ns-num-btn.ns-active .ns-circle {
    animation: ns-progress-{{ section.id }} {{ autoplay_sec | plus: 2 }}s linear forwards;
  }

  @keyframes ns-progress-{{ section.id }} {
    0%   { stroke-dashoffset: 125.664px; }
    90%  { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -125.664px; }
  }
  {% endif %}

  .ns-hide { display: none !important; }

  @media(min-width: 1024px) {
    .section-{{ section.id }} {
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
    }
    .section-{{ section.id }}-settings {
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
    }
    .ns-desktop-image-{{ section.id }} { display: block !important; }
    .ns-mobile-image-{{ section.id }}  { display: none  !important; }
  }

  .slide-show4-cont .custom-slideshow-content-block_kmrpxH,
  .slide-show4-cont .custom-slideshow-content-block_KLdWEy {
    max-width: 1280px;
    padding: 12px 24px;
  }
{%- endstyle -%}

{% unless full_width %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: {{ content_width }}rem;
      padding-left: {{ padding_horizontal_mobile }}rem;
      padding-right: {{ padding_horizontal_mobile }}rem;
    }
    @media(min-width: 1024px) {
      .section-{{ section.id }}-settings {
        padding-left: {{ padding_horizontal }}rem;
        padding-right: {{ padding_horizontal }}rem;
      }
    }
  </style>
{% endunless %}

{% if controls == 'fill-btn' %}
  <style>
    .ns-btn-prev-{{ section.id }},
    .ns-btn-next-{{ section.id }} {
      background-color: {{ bg_btn_color }};
    }
    .ns-btn-prev-{{ section.id }}:hover,
    .ns-btn-next-{{ section.id }}:hover {
      background-color: {{ bg_btn_hover_color }};
    }
  </style>
{% endif %}

{% for block in section.blocks %}
  <style>
    {{ block.settings.heading_font | font_face: font_display: 'swap' }}
    {{ block.settings.subheading_font | font_face: font_display: 'swap' }}
    {{ block.settings.text_font | font_face: font_display: 'swap' }}
    {{ block.settings.button_font | font_face: font_display: 'swap' }}

    .ns-slide-block-{{ block.id }} {
      background-color: {{ block.settings.slide_bg_color }};
    }

    .ns-slide-block-{{ block.id }}::after {
      background-color: black;
      opacity: {{ block.settings.image_overlay }}%;
    }

    .ns-content-{{ block.id }} {
      position: absolute;
      z-index: 2;
      width: 100%;
      height: fit-content;
      max-width: {{ block.settings.container_width_mobile }}%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: {{ block.settings.container_padding_vertical | times: 0.75 | round: 0 }}px {{ block.settings.container_padding_horizontal | times: 0.75 | round: 0 }}px;
    }

    .ns-content-{{ block.id }} h2 {
      margin: 0;
      width: 100%;
      font-size: {{ block.settings.heading_size_mobile }}px;
      color: {{ block.settings.heading_color }};
      line-height: {{ block.settings.heading_height }}%;
      letter-spacing: {{ block.settings.heading_letter }}px;
      text-transform: unset;
      text-align: {{ block.settings.heading_align }};
    }

    .ns-content-{{ block.id }} h4 {
      margin: 0;
      width: 100%;
      font-size: {{ block.settings.subheading_size_mobile }}px;
      color: {{ block.settings.subheading_color }};
      line-height: {{ block.settings.subheading_height }}%;
      letter-spacing: {{ block.settings.subheading_letter }}px;
      text-transform: unset;
      text-align: {{ block.settings.subheading_align }};
    }

    .ns-content-{{ block.id }} p {
      margin: 0;
      margin-top: {{ block.settings.text_mt | times: 0.75 | round: 0 }}px;
      font-size: {{ block.settings.text_size_mobile }}px;
      color: {{ block.settings.text_color }};
      line-height: {{ block.settings.text_height }}%;
      letter-spacing: {{ block.settings.text_letter }}px;
      text-transform: unset;
      text-align: {{ block.settings.text_align }};
    }

    .ns-content-{{ block.id }} a {
      display: block;
      width: fit-content;
      margin: 0;
      margin-top: {{ block.settings.button_mt | times: 0.75 | round: 0 }}px;
      font-size: {{ block.settings.button_size_mobile }}px;
      color: {{ block.settings.button_color }};
      line-height: {{ block.settings.button_height }}%;
      letter-spacing: {{ block.settings.button_letter }}px;
      text-transform: unset;
      text-decoration: none;
      transition: all 0.3s ease;
    }

    .ns-content-{{ block.id }} a:hover {
      color: {{ block.settings.button_hover_color }};
    }

    @media(min-width: 1024px) {
      .ns-content-{{ block.id }} {
        max-width: {{ block.settings.container_width }}%;
      }
      .ns-content-{{ block.id }} h2 { font-size: {{ block.settings.heading_size }}px; }
      .ns-content-{{ block.id }} h4 { font-size: {{ block.settings.subheading_size }}px; }
      .ns-content-{{ block.id }} p  {
        margin-top: {{ block.settings.text_mt }}px;
        font-size: {{ block.settings.text_size }}px;
      }
      .ns-content-{{ block.id }} a  {
        margin-top: {{ block.settings.button_mt }}px;
        font-size: {{ block.settings.button_size }}px;
      }
    }
  </style>

  {% if block.settings.container_use %}
    {%- capture rgb -%}{{ block.settings.container_bg | color_to_rgb }}{%- endcapture -%}
    {%- assign tail = block.settings.container_alpha | prepend: ', ' | append: ')' -%}
    <style>
      .ns-content-{{ block.id }} {
        background-color: {{ rgb | replace: 'rgb', 'rgba' | replace: ')', tail }};
        border-radius: {{ block.settings.container_radius }}px;
      }
    </style>
  {% endif %}

  {% case block.settings.container_align %}
    {% when 'top-left' %}
      <style>
        .ns-content-{{ block.id }} { top: 50%; left: 50%; transform: translate(-50%,-50%); }
        @media(min-width: 1024px) { .ns-content-{{ block.id }} { top: 0; left: 0; transform: translate(0); } }
      </style>
    {% when 'top-center' %}
      <style>
        .ns-content-{{ block.id }} { top: 50%; left: 50%; transform: translate(-50%,-50%); }
        @media(min-width: 1024px) { .ns-content-{{ block.id }} { top: 0; left: 50%; transform: translate(-50%, 0); } }
      </style>
    {% when 'top-right' %}
      <style>
        .ns-content-{{ block.id }} { top: 50%; left: 50%; transform: translate(-50%,-50%); }
        @media(min-width: 1024px) { .ns-content-{{ block.id }} { top: 0; left: unset; right: 0; transform: translate(0); } }
      </style>
    {% when 'middle-left' %}
      <style>
        .ns-content-{{ block.id }} { top: 50%; left: 50%; transform: translate(-50%,-50%); }
        @media(min-width: 1024px) { .ns-content-{{ block.id }} { top: 50%; left: 0; transform: translate(0,-50%); } }
      </style>
    {% when 'middle-center' %}
      <style>
        .ns-content-{{ block.id }} { top: 50%; left: 50%; transform: translate(-50%,-50%); }
      </style>
    {% when 'middle-right' %}
      <style>
        .ns-content-{{ block.id }} { top: 50%; left: 50%; transform: translate(-50%,-50%); }
        @media(min-width: 1024px) { .ns-content-{{ block.id }} { top: 50%; left: unset; right: 0; transform: translate(0,-50%); } }
      </style>
    {% when 'bottom-left' %}
      <style>
        .ns-content-{{ block.id }} { top: 50%; left: 50%; transform: translate(-50%,-50%); }
        @media(min-width: 1024px) { .ns-content-{{ block.id }} { top: unset; bottom: 0; left: 0; transform: translate(0); } }
      </style>
    {% when 'bottom-center' %}
      <style>
        .ns-content-{{ block.id }} { top: 50%; left: 50%; transform: translate(-50%,-50%); }
        @media(min-width: 1024px) { .ns-content-{{ block.id }} { top: unset; bottom: 0; left: 50%; transform: translate(-50%,0); } }
      </style>
    {% when 'bottom-right' %}
      <style>
        .ns-content-{{ block.id }} { top: 50%; left: 50%; transform: translate(-50%,-50%); }
        @media(min-width: 1024px) { .ns-content-{{ block.id }} { top: unset; left: unset; bottom: 0; right: 0; transform: translate(0); } }
      </style>
  {% endcase %}

  {% if block.settings.button_style == 'button' %}
    <style>
      .ns-content-{{ block.id }} a {
        padding: {{ block.settings.button_padding_vertical | times: 0.75 | round: 0 }}px {{ block.settings.button_padding_horizontal | times: 0.75 | round: 0 }}px;
        border-radius: {{ block.settings.button_radius }}px;
        background-color: {{ block.settings.button_bg_color }};
        border: {{ block.settings.button_thickness }}px solid {{ block.settings.button_border_color }};
      }
      .ns-content-{{ block.id }} a:hover {
        background-color: {{ block.settings.button_bg_hover_color }};
        border-color: {{ block.settings.button_border_hover_color }};
      }
      @media(min-width: 750px) {
        .ns-content-{{ block.id }} a {
          padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
        }
      }
    </style>
  {% endif %}

  {% if block.settings.button_align == 'center' %}
    <style>.ns-content-{{ block.id }} a { margin-left: auto; margin-right: auto; }</style>
  {% elsif block.settings.button_align == 'right' %}
    <style>.ns-content-{{ block.id }} a { margin-left: auto; }</style>
  {% endif %}

  {% if image_custom_mobile %}
    <style>
      .ns-slide-block-{{ block.id }} { height: {{ image_height_mobile }}px; }
      @media(min-width: 1024px) { .ns-slide-block-{{ block.id }} { height: auto; } }
    </style>
  {% endif %}

  {% if image_custom %}
    <style>
      @media(min-width: 1024px) { .ns-slide-block-{{ block.id }} { height: {{ image_height_desktop }}px; } }
    </style>
  {% endif %}

  {% if block.settings.heading_custom %}
    <style>
      .ns-content-{{ block.id }} h2 {
        font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
        font-weight: {{ block.settings.heading_font.weight }};
        font-style: {{ block.settings.heading_font.style }};
      }
    </style>
  {% endif %}

  {% if block.settings.subheading_custom %}
    <style>
      .ns-content-{{ block.id }} h4 {
        font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
        font-weight: {{ block.settings.subheading_font.weight }};
        font-style: {{ block.settings.subheading_font.style }};
      }
    </style>
  {% endif %}

  {% if block.settings.text_custom %}
    <style>
      .ns-content-{{ block.id }} p {
        font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
        font-weight: {{ block.settings.text_font.weight }};
        font-style: {{ block.settings.text_font.style }};
      }
    </style>
  {% endif %}

  {% if block.settings.button_custom %}
    <style>
      .ns-content-{{ block.id }} a {
        font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
        font-weight: {{ block.settings.button_font.weight }};
        font-style: {{ block.settings.button_font.style }};
      }
    </style>
  {% endif %}

  {% if block.settings.image == blank %}
    {% if hide_image %}
      <style>
        .ns-slide-block-{{ block.id }} { padding: {{ block.settings.slide_padding_vertical }}px {{ block.settings.slide_padding_horizontal }}px; }
        .ns-slide-block-{{ block.id }} > svg,
        .ns-slide-block-{{ block.id }}::after { display: none; }
        .ns-content-{{ block.id }} { position: static; margin: 0 auto; }
        @media(max-width: 1023px) { .ns-content-{{ block.id }} { transform: translate(0); } }
        @media(min-width: 1024px) {
          .ns-slide-block-{{ block.id }} { padding: 0; }
          .ns-slide-block-{{ block.id }} > svg,
          .ns-slide-block-{{ block.id }}::after { display: block; }
          .ns-content-{{ block.id }} { position: absolute; margin: 0; }
        }
      </style>
    {% endif %}
  {% else %}
    {% if hide_image %}
      <style>
        .ns-slide-block-{{ block.id }} { padding: {{ block.settings.slide_padding_vertical }}px {{ block.settings.slide_padding_horizontal }}px; }
        .ns-slide-block-{{ block.id }} > img,
        .ns-slide-block-{{ block.id }}::after { display: none; }
        .ns-content-{{ block.id }} { position: static; margin: 0 auto; }
        @media(max-width: 1023px) { .ns-content-{{ block.id }} { transform: translate(0); } }
        @media(min-width: 1024px) {
          .ns-slide-block-{{ block.id }} { padding: 0; }
          .ns-slide-block-{{ block.id }} > img,
          .ns-slide-block-{{ block.id }}::after { display: block; }
          .ns-content-{{ block.id }} { position: absolute; margin: 0; }
        }
      </style>
    {% endif %}
  {% endif %}
{% endfor %}

<style>
  .restrad-sauna .slideshow-4-content { max-width: 95%; }
  @media (max-width: 767px) {
    .template-collection-eofy-sale .slideshow-4-content h2,
    .template-collection-eofy-sale .slideshow-4-content p,
    .template-collection-eofy-sale .slideshow-4-content a { text-align: left; }
    .template-collection-eofy-sale .ns-content-block_dVxaRC.slideshow-4-content { bottom: -25px; left: 30%; max-width: 56%; }
    .template-collection-eofy-sale .slideshow-4-content p br { display: none; }
    .template-collection-eofy-sale .slideshow-4-content p i.save-up { display: block; font-size: 14px !important; margin-top: 10px; }
    .slideshow-4-content { top: auto; bottom: -15%; }
    .ns-dots-{{ section.id }} { position: absolute; bottom: 5px !important; top: unset !important; left: 5px !important; right: auto; z-index: 99999999; width: fit-content !important; }
    .ns-dots-{{ section.id }} .ns-dot:not(:last-child) { margin-right: 10px; }
  }
</style>

<div class="section-{{ section.id }} slide-show4" style="background-color:{{ background_color }}; background-image: {{ background_gradient }}; cursor: pointer;">
  <div class="section-{{ section.id }}-settings">
    <div class="ns-slider-{{ section.id }} slide-show4-cont" id="ns-slider-{{ section.id }}">

      {% for block in section.blocks %}
        <{% if block.settings.slide_url != blank %}a href="{{ block.settings.slide_url }}"{% else %}div{% endif %}
          class="ns-slide-{{ section.id }} ns-slide-block-{{ block.id }}{% if forloop.first %} ns-active{% endif %} {{ block.settings.slideclass }}"
          data-index="{{ forloop.index0 }}"
        >
          {% if block.settings.image != blank or block.settings.image_mobile != blank %}
            {% if block.settings.image != blank %}
              <img
                {% if block.settings.image_mobile != blank %}class="ns-desktop-image-{{ section.id }}"{% endif %}
                src="{{ block.settings.image | image_url }}"
                alt="slideshow-desktop-{{ block.id }}"
                {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy" fetchpriority="low"{% endif %}
              >
            {% endif %}
            {% if block.settings.image_mobile != blank %}
              <img
                class="ns-mobile-image-{{ section.id }}"
                src="{{ block.settings.image_mobile | image_url }}"
                alt="slideshow-mobile-{{ block.id }}"
                {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy" fetchpriority="low"{% endif %}
              >
            {% endif %}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {% endif %}

          <div class="ns-content-{{ block.id }} slideshow-4-content">
            {% if block.settings.subheading != blank %}<h4>{{ block.settings.subheading }}</h4>{% endif %}
            {% if block.settings.heading != blank %}<h2>{{ block.settings.heading }}</h2>{% endif %}
            {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
            {% if block.settings.custom_html != blank %}<div class="slideshow-html">{{ block.settings.custom_html }}</div>{% endif %}
            {% unless block.settings.slide_url %}
              {% if block.settings.button != blank %}
                <a href="{{ block.settings.button_url }}">{{ block.settings.button }}</a>
              {% endif %}
            {% endunless %}
          </div>

        </{% if block.settings.slide_url != blank %}a{% else %}div{% endif %}>
      {% endfor %}

      {% if use_controls %}
        {% assign show_btns = false %}
        {% if controls == 'btn' or controls == 'fill-btn' %}{% assign show_btns = true %}{% endif %}

        <button class="ns-btn-prev-{{ section.id }}{% unless show_btns %} ns-hide{% endunless %}" aria-label="Previous slide">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z"/></svg>
        </button>
        <button class="ns-btn-next-{{ section.id }}{% unless show_btns %} ns-hide{% endunless %}" aria-label="Next slide">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z"/></svg>
        </button>

        <div class="ns-dots-{{ section.id }}{% unless controls == 'dots' %} ns-hide{% endunless %}">
          {% for block in section.blocks %}
            <button class="ns-dot{% if forloop.first %} ns-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
          {% endfor %}
        </div>

        <div class="ns-numbers-{{ section.id }}{% unless controls == 'numbers' %} ns-hide{% endunless %}">
          {% for block in section.blocks %}
            <button class="ns-num-btn{% if forloop.first %} ns-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}">
              {% if autoplay %}
                <svg class="ns-progress-svg" width="43" height="43">
                  <circle class="ns-circle" r="20" cx="21.5" cy="21.5"></circle>
                </svg>
              {% endif %}
              <span class="ns-label">{{ forloop.index }}</span>
            </button>
          {% endfor %}
        </div>
      {% endif %}

    </div>
  </div>
</div>

<script>
(function() {
  function initSlider() {
    var sliderId = 'ns-slider-{{ section.id }}';
    var wrapper  = document.getElementById(sliderId);
    if (!wrapper) return;

    var slides    = Array.from(wrapper.querySelectorAll('.ns-slide-{{ section.id }}'));
    var dots      = Array.from(wrapper.querySelectorAll('.ns-dots-{{ section.id }} .ns-dot'));
    var numBtns   = Array.from(wrapper.querySelectorAll('.ns-numbers-{{ section.id }} .ns-num-btn'));
    var btnPrev   = wrapper.querySelector('.ns-btn-prev-{{ section.id }}');
    var btnNext   = wrapper.querySelector('.ns-btn-next-{{ section.id }}');
    var autoplay  = {{ autoplay | json }};
    var delay     = Math.max({{ autoplay_sec }} * 1000, 10000);
    var current   = 0;
    var total     = slides.length;
    var timer     = null;

    function goTo(index) {
      // Loop
      index = (index + total) % total;

      // Slides
      slides[current].classList.remove('ns-active');
      slides[index].classList.add('ns-active');

      // Dots
      if (dots[current]) dots[current].classList.remove('ns-active');
      if (dots[index])   dots[index].classList.add('ns-active');

      // Number buttons — restart animation by clone-replacing the active one
      if (numBtns.length) {
        numBtns[current].classList.remove('ns-active');

        // Clone to retrigger CSS animation
        var old = numBtns[index];
        var clone = old.cloneNode(true);
        old.parentNode.replaceChild(clone, old);
        numBtns[index] = clone;
        clone.classList.add('ns-active');

        // Re-bind click on the cloned button
        clone.addEventListener('click', function() {
          goTo(parseInt(clone.dataset.index));
          resetTimer();
        });
      }

      current = index;
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    function startTimer() {
      if (!autoplay || total <= 1) return;
      timer = setInterval(next, delay);
    }

    function resetTimer() {
      clearInterval(timer);
      startTimer();
    }

    // Prev / Next buttons
    if (btnPrev) btnPrev.addEventListener('click', function() { prev(); resetTimer(); });
    if (btnNext) btnNext.addEventListener('click', function() { next(); resetTimer(); });

    // Dots
    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        goTo(parseInt(dot.dataset.index));
        resetTimer();
      });
    });

    // Number buttons (initial bind; cloned ones are rebound in goTo)
    numBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        goTo(parseInt(btn.dataset.index));
        resetTimer();
      });
    });

    // Touch / swipe support
    var touchStartX = 0;
    wrapper.addEventListener('touchstart', function(e) {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    wrapper.addEventListener('touchend', function(e) {
      var diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) {
        diff > 0 ? next() : prev();
        resetTimer();
      }
    }, { passive: true });

    startTimer();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSlider);
  } else {
    initSlider();
  }

  // Shopify theme editor re-init
  if (typeof Shopify !== 'undefined' && Shopify.designMode) {
    document.addEventListener('shopify:section:load',   initSlider);
    document.addEventListener('shopify:section:unload', initSlider);
  }
})();
</script>

