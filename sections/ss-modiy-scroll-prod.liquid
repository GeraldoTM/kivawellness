{%- liquid
  assign padding_horizontal = section.settings.padding_horizontal
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign border_color = section.settings.border_color
  assign border_thickness = section.settings.border_thickness
  assign margin_top = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign background_color = section.settings.background_color
  assign background_gradient = section.settings.background_gradient
  assign full_width = section.settings.full_width
  assign content_width = section.settings.content_width
  assign lazy = section.settings.lazy

  assign heading = section.settings.heading
  assign subheading = section.settings.sub_heading
  assign heading_size = section.settings.heading_size
  assign heading_size_mobile = section.settings.heading_size_mobile
  assign heading_color = section.settings.heading_color
  assign heading_custom = section.settings.heading_custom
  assign heading_font = section.settings.heading_font
  assign heading_height = section.settings.heading_height
  assign heading_align = section.settings.heading_align
  assign heading_align_mobile = section.settings.heading_align_mobile

  assign products = section.settings.products
  assign collection = section.settings.collection
  assign collection_show_all = section.settings.collection_show_all
  assign collection_show = section.settings.collection_show

  assign card_width_mobile = section.settings.card_width_mobile
  assign card_width = section.settings.card_width
  assign card_radius = section.settings.card_radius
  assign card_border_thickness = section.settings.card_border_thickness
  assign card_border_color = section.settings.card_border_color
  assign card_bg_color = section.settings.card_bg_color
  assign card_shadow = section.settings.card_shadow
  assign card_shadow_color = section.settings.card_shadow_color

  assign content_padding_vertical = section.settings.content_padding_vertical
  assign content_padding_vertical_mobile = section.settings.content_padding_vertical_mobile
  assign content_padding_horizontal = section.settings.content_padding_horizontal
  assign content_padding_horizontal_mobile = section.settings.content_padding_horizontal_mobile

  assign title_size = section.settings.title_size
  assign title_size_mobile = section.settings.title_size_mobile
  assign title_color = section.settings.title_color
  assign title_custom = section.settings.title_custom
  assign title_font = section.settings.title_font
  assign title_height = section.settings.title_height
  assign title_uppercase = section.settings.title_uppercase

  assign price_size = section.settings.price_size
  assign price_size_mobile = section.settings.price_size_mobile
  assign price_color = section.settings.price_color
  assign price_custom = section.settings.price_custom
  assign price_font = section.settings.price_font
  assign price_height = section.settings.price_height
  assign price_mt = section.settings.price_mt

  assign button = section.settings.button
  assign button_size = section.settings.button_size
  assign button_size_mobile = section.settings.button_size_mobile
  assign button_color = section.settings.button_color
  assign button_hover_color = section.settings.button_hover_color
  assign button_custom = section.settings.button_custom
  assign button_font = section.settings.button_font
  assign button_height = section.settings.button_height
  assign button_mt = section.settings.button_mt
  assign button_padding_vertical = section.settings.button_padding_vertical
  assign button_padding_horizontal = section.settings.button_padding_horizontal
  assign button_padding_vertical_mobile = section.settings.button_padding_vertical_mobile
  assign button_padding_horizontal_mobile = section.settings.button_padding_horizontal_mobile
  assign button_radius = section.settings.button_radius
  assign button_border_thickness = section.settings.button_border_thickness
  assign button_border_color = section.settings.button_border_color
  assign button_border_hover_color = section.settings.button_border_hover_color
  assign button_bg_color = section.settings.button_bg_color
  assign button_bg_hover_color = section.settings.button_bg_hover_color
  assign button_arrow = section.settings.button_arrow

  assign badge = section.settings.badge
  assign badge_size = section.settings.badge_size
  assign badge_size_mobile = section.settings.badge_size_mobile
  assign badge_color = section.settings.badge_color
  assign badge_custom = section.settings.badge_custom
  assign badge_font = section.settings.badge_font
  assign badge_height = section.settings.badge_height
  assign badge_bg_color = section.settings.badge_bg_color
  assign badge_padding_vertical = section.settings.badge_padding_vertical
  assign badge_padding_horizontal = section.settings.badge_padding_horizontal
  assign badge_padding_vertical_mobile = section.settings.badge_padding_vertical_mobile
  assign badge_padding_horizontal_mobile = section.settings.badge_padding_horizontal_mobile
-%}

{% if heading_custom %}{{ heading_font | font_face: font_display: 'swap' }}{% endif %}
{% if title_custom %}{{ title_font | font_face: font_display: 'swap' }}{% endif %}
{% if price_custom %}{{ price_font | font_face: font_display: 'swap' }}{% endif %}
{% if button_custom %}{{ button_font | font_face: font_display: 'swap' }}{% endif %}
{% if badge_custom %}{{ badge_font | font_face: font_display: 'swap' }}{% endif %}

<style>
  .s{{ section.id }} {
    border-top: {{ border_thickness }}px solid {{ border_color }};
    border-bottom: {{ border_thickness }}px solid {{ border_color }};
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
    overflow: hidden;
    background-color: {{ background_color }};
    background-image: {{ background_gradient }};
    contain: layout style;
  }
  .s{{ section.id }}-wrap {
    margin: 0 auto;
    padding: {{ padding_top | times: 0.75 | round: 0 }}px {{ padding_horizontal_mobile }}rem {{ padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .s{{ section.id }}-hd { text-align: {{ heading_align_mobile }}; margin-bottom: 16px; }
  .s{{ section.id }}-hd * {
    margin: 0;
    font-size: {{ heading_size_mobile }}px;
    color: {{ heading_color }};
    line-height: {{ heading_height }}%;
    {% if heading_custom %}
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-weight: {{ heading_font.weight }};
    font-style: {{ heading_font.style }};
    {% endif %}
  }
  .s{{ section.id }}-subhd {
    text-align: {{ heading_align_mobile }};
    margin-bottom: 26px;
    font-size: {{ section.settings.subheading_size_mobile }}px;
    color: {{ section.settings.subheading_color }};
    line-height: 160%;
    font-style: italic;
  }
  .s{{ section.id }}-subhd * { margin: 0; }

  .s{{ section.id }}-track {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 16px;
    padding-bottom: 4px;
    min-height: 200px;
  }
  .s{{ section.id }}-track::-webkit-scrollbar { display: none; }

  .s{{ section.id }}-card {
    flex: 0 0 {{ card_width_mobile }}px;
    scroll-snap-align: start;
    border-radius: {{ card_radius }}px;
    border: {{ card_border_thickness }}px solid {{ card_border_color }};
    background-color: {{ card_bg_color }};
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
    contain: layout style paint;
    {% if card_shadow %}
    box-shadow: 0 2px 8px {{ card_shadow_color | color_modify: 'alpha', 0.15 }};
    {% endif %}
  }

  .s{{ section.id }}-img {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    display: block;
  }
  .s{{ section.id }}-img img,
  .s{{ section.id }}-img svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .s{{ section.id }}-img svg { background: #DEDEDE; }
  .s{{ section.id }}-img--sale img,
  .s{{ section.id }}-img--sale svg { aspect-ratio: 1 / 0.81; }

  .s{{ section.id }}-content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    padding: {{ content_padding_vertical_mobile }}px {{ content_padding_horizontal_mobile }}px;
  }
  .s{{ section.id }}-inner {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .s{{ section.id }}-title {
    display: block;
    margin: 0;
    font-size: {{ title_size_mobile }}px;
    color: {{ title_color }};
    line-height: {{ title_height }}%;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    {% if title_uppercase %}text-transform: uppercase;{% endif %}
    {% if title_custom %}
    font-family: {{ title_font.family }}, {{ title_font.fallback_families }};
    font-weight: {{ title_font.weight }};
    font-style: {{ title_font.style }};
    {% endif %}
  }

  .s{{ section.id }}-price {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    justify-content: center;
    margin-top: {{ price_mt | times: 0.75 | round: 0 }}px;
  }
  .s{{ section.id }}-price-main {
    margin: 0;
    font-size: {{ price_size_mobile }}px;
    color: {{ price_color }};
    line-height: {{ price_height }}%;
    font-weight: 700;
    {% if price_custom %}
    font-family: {{ price_font.family }}, {{ price_font.fallback_families }};
    font-weight: {{ price_font.weight }};
    font-style: {{ price_font.style }};
    {% endif %}
  }
  .s{{ section.id }}-price-crossed {
    margin: 0;
    color: #999;
    text-decoration: line-through;
    font-size: {{ price_size_mobile | times: 0.75 | round: 0 }}px;
    {% if price_custom %}
    font-family: {{ price_font.family }}, {{ price_font.fallback_families }};
    {% endif %}
  }

  .s{{ section.id }}-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin: {{ button_mt | times: 0.75 | round: 0 }}px 0 0;
    font-size: {{ button_size_mobile }}px;
    color: {{ button_color }};
    line-height: {{ button_height }}%;
    text-align: center;
    text-decoration: none;
    font-weight: 700;
    padding: {{ button_padding_vertical_mobile }}px {{ button_padding_horizontal_mobile }}px;
    border-radius: {{ button_radius }}px;
    border: {{ button_border_thickness }}px solid {{ button_border_color }};
    background-color: {{ button_bg_color }};
    transition: color .25s,border-color .25s,background-color .25s;
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    {% if button_custom %}
    font-family: {{ button_font.family }}, {{ button_font.fallback_families }};
    font-weight: {{ button_font.weight }};
    font-style: {{ button_font.style }};
    {% endif %}
  }
  .s{{ section.id }}-btn:hover {
    color: {{ button_hover_color }};
    border-color: {{ button_border_hover_color }};
    background-color: {{ button_bg_hover_color }};
  }
  .s{{ section.id }}-btn svg {
    width: 20px; height: 20px;
    stroke: {{ button_color }};
    transition: stroke .25s;
  }
  .s{{ section.id }}-btn:hover svg { stroke: {{ button_hover_color }}; }

  .s{{ section.id }}-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    font-size: {{ badge_size_mobile }}px;
    color: {{ badge_color }};
    line-height: {{ badge_height }}%;
    font-weight: 700;
    padding: {{ badge_padding_vertical_mobile }}px {{ badge_padding_horizontal_mobile }}px;
    background-color: {{ badge_bg_color }};
    box-sizing: border-box;
    {% if badge_custom %}
    font-family: {{ badge_font.family }}, {{ badge_font.fallback_families }};
    font-weight: {{ badge_font.weight }};
    font-style: {{ badge_font.style }};
    {% endif %}
  }

  .s{{ section.id }}-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 20px;
  }
  .s{{ section.id }}-nav button {
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    flex: 0 0 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity .25s;
  }
  .s{{ section.id }}-nav button svg { width: 50px; height: auto; }
  .s{{ section.id }}-nav button[disabled] { opacity: .3; pointer-events: none; }

  @media (min-width: 1024px) {
    .s{{ section.id }} { margin-top: {{ margin_top }}px; margin-bottom: {{ margin_bottom }}px; }
    .s{{ section.id }}-wrap {
      padding: {{ padding_top }}px {{ padding_horizontal }}rem {{ padding_bottom }}px;
    }
    .s{{ section.id }}-hd { text-align: {{ heading_align }}; }
    .s{{ section.id }}-hd * { font-size: {{ heading_size }}px; }
    .s{{ section.id }}-subhd { text-align: {{ heading_align }}; font-size: {{ section.settings.subheading_size }}px; }
    .s{{ section.id }}-card { flex-basis: {{ card_width }}px; }
    .s{{ section.id }}-track { gap: 30px; }
    .s{{ section.id }}-content { padding: {{ content_padding_vertical }}px {{ content_padding_horizontal }}px; }
    .s{{ section.id }}-title { font-size: {{ title_size }}px; }
    .s{{ section.id }}-price { margin-top: {{ price_mt }}px; }
    .s{{ section.id }}-price-main { font-size: {{ price_size }}px; }
    .s{{ section.id }}-price-crossed { font-size: {{ price_size | times: 0.75 | round: 0 }}px; }
    .s{{ section.id }}-btn {
      margin-top: {{ button_mt }}px;
      padding: {{ button_padding_vertical }}px {{ button_padding_horizontal }}px;
      font-size: {{ button_size }}px;
    }
    .s{{ section.id }}-badge {
      font-size: {{ badge_size }}px;
      padding: {{ badge_padding_vertical }}px {{ badge_padding_horizontal }}px;
    }
  }
  @media (max-width: 768px) {
    .s{{ section.id }}-nav button svg { width: 35px; }
  }
</style>

{% unless full_width %}
  <style>
    .s{{ section.id }}-wrap { max-width: {{ content_width }}rem; }
  </style>
{% endunless %}

{%- capture products_html -%}
  {%- liquid
    if collection != blank
      assign current_collection = collections[collection]
      if collection_show_all
        assign product_list = current_collection.products
      else
        assign product_list = current_collection.products | slice: 0, collection_show
      endif
    elsif products != blank
      assign product_list = products
    else
      assign product_list = nil
    endif
  -%}

  {%- if product_list != nil -%}
    {%- for product in product_list -%}
      {%- liquid
        assign on_sale = false
        if product.compare_at_price > product.price
          assign on_sale = true
        endif
        assign img_loading = 'lazy'
        assign img_priority = ''
        if forloop.index <= 2
          assign img_loading = 'eager'
          assign img_priority = 'fetchpriority="high"'
        endif
      -%}
      <a
        href="{{ product.url }}"
        class="s{{ section.id }}-card"
        aria-label="{{ product.title | escape }}"
      >
        {%- if badge != blank and on_sale -%}
          <span class="s{{ section.id }}-badge" aria-label="Sale badge">{{ badge }}</span>
        {%- endif -%}

        <div class="s{{ section.id }}-img{% if on_sale %} s{{ section.id }}-img--sale{% endif %}">
          {%- if product.featured_image -%}
            <img
              src="{{ product.featured_image | image_url: width: 400 }}"
              srcset="
                {{ product.featured_image | image_url: width: 200 }} 200w,
                {{ product.featured_image | image_url: width: 400 }} 400w,
                {{ product.featured_image | image_url: width: 600 }} 600w,
                {{ product.featured_image | image_url: width: 800 }} 800w
              "
              sizes="(min-width: 1024px) {{ card_width }}px, {{ card_width_mobile }}px"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
              loading="{{ img_loading }}"
              {{ img_priority }}
              decoding="{% if forloop.index <= 2 %}sync{% else %}async{% endif %}"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>

        <div class="s{{ section.id }}-content">
          <div class="s{{ section.id }}-inner">
            <span class="s{{ section.id }}-title">{{ product.title | escape }}</span>

            <div class="s{{ section.id }}-price">
              {%- if on_sale -%}
                <span class="s{{ section.id }}-price-crossed">{{ product.compare_at_price | money }}</span>
                <span class="s{{ section.id }}-price-main">{{ product.price | money }}</span>
              {%- else -%}
                <span class="s{{ section.id }}-price-main">{{ product.price | money }}</span>
              {%- endif -%}
            </div>

            {%- if button != blank -%}
              <span class="s{{ section.id }}-btn" role="presentation" aria-hidden="true">
                {{ button }}
                {%- if button_arrow -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                {%- endif -%}
              </span>
            {%- endif -%}
          </div>
        </div>
      </a>
    {%- endfor -%}

  {%- else -%}
    {%- for i in (1..6) -%}
      <div class="s{{ section.id }}-card" aria-hidden="true">
        <div class="s{{ section.id }}-img">{{ 'product-' | append: forloop.index | placeholder_svg_tag }}</div>
        <div class="s{{ section.id }}-content">
          <div class="s{{ section.id }}-inner">
            <span class="s{{ section.id }}-title">Product title</span>
            <div class="s{{ section.id }}-price">
              <span class="s{{ section.id }}-price-main">$0.00</span>
            </div>
            {%- if button != blank -%}
              <span class="s{{ section.id }}-btn" role="presentation" aria-hidden="true">{{ button }}</span>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<div
  class="s{{ section.id }}"
  style="background-color:{{ background_color }};background-image:{{ background_gradient }};"
>
  <div class="s{{ section.id }}-wrap">
    {%- if heading != blank -%}
      <div class="s{{ section.id }}-hd">{{ heading }}</div>
    {%- endif -%}
    {%- if subheading != blank -%}
      <div class="s{{ section.id }}-subhd">{{ subheading }}</div>
    {%- endif -%}

    <div class="s{{ section.id }}-track" id="track-{{ section.id }}" role="list" aria-label="Products">
      {{ products_html }}
    </div>

    <div class="s{{ section.id }}-nav" aria-label="Scroll controls">
      <button id="prev-{{ section.id }}" aria-label="Previous products">
        <svg width="92" height="38" viewBox="0 0 92 38" fill="none" aria-hidden="true" style="transform:rotate(180deg)">
          <path d="M72.472 0L71.063 1.409L87.303 17.649H0V19.643H87.3L71.06 35.883L72.469 37.293L91.115 18.646L72.472 0Z" fill="currentColor"/>
        </svg>
      </button>
      <button id="next-{{ section.id }}" aria-label="Next products">
        <svg width="92" height="38" viewBox="0 0 92 38" fill="none" aria-hidden="true">
          <path d="M72.472 0L71.063 1.409L87.303 17.649H0V19.643H87.3L71.06 35.883L72.469 37.293L91.115 18.646L72.472 0Z" fill="currentColor"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    var id = '{{ section.id }}';
    var track = document.getElementById('track-' + id);
    var prev = document.getElementById('prev-' + id);
    var next = document.getElementById('next-' + id);
    if (!track) return;

    var realCards = Array.prototype.slice.call(track.querySelectorAll('.s' + id + '-card'));
    if (realCards.length < 2) return;

    realCards.forEach(function (card) {
      var c = card.cloneNode(true);
      c.setAttribute('aria-hidden', 'true');
      c.setAttribute('data-clone', '1');
      var img = c.querySelector('img');
      if (img) {
        img.loading = 'eager';
        img.removeAttribute('fetchpriority');
      }
      track.appendChild(c);
    });

    realCards
      .slice()
      .reverse()
      .forEach(function (card) {
        var c = card.cloneNode(true);
        c.setAttribute('aria-hidden', 'true');
        c.setAttribute('data-clone', '1');
        var img = c.querySelector('img');
        if (img) img.loading = 'eager';
        track.insertBefore(c, track.firstChild);
      });

    function gap() {
      return parseInt(getComputedStyle(track).gap) || 16;
    }
    function step() {
      return realCards[0].offsetWidth + gap();
    }
    function setWidth() {
      return realCards.reduce(function (s, c) {
        return s + c.offsetWidth + gap();
      }, 0);
    }

    function init() {
      track.style.scrollBehavior = 'auto';
      track.scrollLeft = setWidth();
      track.style.scrollBehavior = '';
    }

    var teleportTimer = null;
    track.addEventListener(
      'scroll',
      function () {
        clearTimeout(teleportTimer);
        teleportTimer = setTimeout(function () {
          var sw = setWidth();
          if (track.scrollLeft < sw - step() * 0.5) {
            track.style.scrollBehavior = 'auto';
            track.scrollLeft += sw;
            track.style.scrollBehavior = '';
          } else if (track.scrollLeft > sw * 2 - step() * 0.5) {
            track.style.scrollBehavior = 'auto';
            track.scrollLeft -= sw;
            track.style.scrollBehavior = '';
          }
        }, 50);
      },
      { passive: true }
    );

    prev.addEventListener('click', function () {
      track.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    next.addEventListener('click', function () {
      track.scrollBy({ left: step(), behavior: 'smooth' });
    });

    requestAnimationFrame(function () {
      requestAnimationFrame(init);
    });

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', function (e) {
        if (e.detail && e.detail.sectionId === id)
          requestAnimationFrame(function () {
            requestAnimationFrame(init);
          });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "SS - Modify Scroll Prod",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "sub_heading",
      "label": "Sub Heading",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus iaculis viverra consequat. Quisque sit amet vestibulum nulla.</p>"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Sub Heading Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Sub Heading Size - Mobile",
      "default": 14
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Sub Heading Color",
      "default": "#444444"
    },
    {
      "type": "checkbox",
      "id": "heading_custom",
      "label": "Use Custom Font",
      "default": false
