{% liquid
  assign heading = section.settings.heading

  assign image_height_mobile_px = section.settings.image_height_mobile
  if image_height_mobile_px == 0
    assign image_height_mobile_px = section.settings.card_width_mobile
  endif

  assign image_height_desktop_px = section.settings.image_height_desktop
  if image_height_desktop_px == 0
    assign image_height_desktop_px = section.settings.card_width_desktop
  endif
%}

<div class="collection-carousel-{{ section.id }}">
  {%- if heading != blank -%}
    <h2
      class="collection-carousel-{{ section.id }}__heading collection-carousel-{{ section.id }}__heading--{{ section.settings.heading_position }}"
      style="
        color: {{ section.settings.heading_color | default: '#1a1a1a' }};
        font-weight: {{ section.settings.heading_font_weight }};
      "
    >
      {{ heading }}
    </h2>
  {%- endif -%}

  <div class="collection-carousel-{{ section.id }}__wrapper">
    <div class="collection-carousel-{{ section.id }}__track" data-carousel-track>
      {% for block in section.blocks %}
        {% liquid
          assign collection = block.settings.collection
          assign title_override = block.settings.title_override
          assign display_title = title_override | default: collection.title
        %}

        <a
          href="{{ collection.url }}"
          class="collection-carousel-{{ section.id }}__card"
          {{ block.shopify_attributes }}
        >
          <div
            class="collection-carousel-{{ section.id }}__image-wrapper"
            {% if block.settings.image_background_color != blank %}
              style="background-color: {{ block.settings.image_background_color }};"
            {% endif %}
          >
            {%- if collection.image != blank -%}
              <img
                src="{{ collection.image | image_url: width: 800 }}"
                alt="{{ collection.image.alt | default: display_title | escape }}"
                loading="lazy"
                class="collection-carousel-{{ section.id }}__image"
              >
            {%- elsif collection.featured_image != blank -%}
              <img
                src="{{ collection.featured_image | image_url: width: 800 }}"
                alt="{{ display_title | escape }}"
                loading="lazy"
                class="collection-carousel-{{ section.id }}__image"
              >
            {%- else -%}
              <div class="collection-carousel-{{ section.id }}__image collection-carousel-{{ section.id }}__placeholder">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}
          </div>

          <div class="collection-carousel-{{ section.id }}__title-row">
            <span class="collection-carousel-{{ section.id }}__title">{{ display_title }}</span>
            <svg
              class="collection-carousel-{{ section.id }}__chevron"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </a>
      {% endfor %}
    </div>

    {% if section.blocks.size > 3 %}
      <button type="button" class="collection-carousel-{{ section.id }}__arrow collection-carousel-{{ section.id }}__arrow--prev" data-carousel-prev aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button type="button" class="collection-carousel-{{ section.id }}__arrow collection-carousel-{{ section.id }}__arrow--next" data-carousel-next aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    {% endif %}
  </div>
</div>

<style>
  .collection-carousel-{{ section.id }} {
    max-width: 100%;
    padding: 32px 24px;
  }

  .collection-carousel-{{ section.id }}__heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    margin: 0 0 20px;
  }

  .collection-carousel-{{ section.id }}__heading--left { text-align: left; }
  .collection-carousel-{{ section.id }}__heading--center { text-align: center; }
  .collection-carousel-{{ section.id }}__heading--right { text-align: right; }

  .collection-carousel-{{ section.id }}__wrapper {
    position: relative;
  }

  .collection-carousel-{{ section.id }}__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }
  .collection-carousel-{{ section.id }}__track.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .collection-carousel-{{ section.id }}__track::-webkit-scrollbar {
    display: none;
  }

  .collection-carousel-{{ section.id }}__card {
    flex: 0 0 {{ section.settings.card_width_mobile }}px;
    scroll-snap-align: start;
    box-sizing: border-box;
    display: block;
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }

  /* Hardcoded square by default — height below only overrides it when a
     merchant sets a value above 0, which limits/caps the image instead
     of letting it stay perfectly square. */
  .collection-carousel-{{ section.id }}__image-wrapper {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 6px;
    background: #f2f2f2;
    {%- if section.settings.image_height_mobile > 0 -%}
      height: {{ section.settings.image_height_mobile }}px;
    {%- endif -%}
  }

  .collection-carousel-{{ section.id }}__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .collection-carousel-{{ section.id }}__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-carousel-{{ section.id }}__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
    gap: 6px;
  }

  .collection-carousel-{{ section.id }}__title {
    font-family: {{ section.settings.title_font }};
    font-size: {{ section.settings.title_font_size_mobile }}px;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .collection-carousel-{{ section.id }}__chevron {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .collection-carousel-{{ section.id }}__arrow {
    position: absolute;
    top: calc({{ image_height_mobile_px }}px / 2);
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .collection-carousel-{{ section.id }}__arrow svg {
    width: 16px;
    height: 16px;
  }

  .collection-carousel-{{ section.id }}__arrow--prev { left: -4px; }
  .collection-carousel-{{ section.id }}__arrow--next { right: -4px; }

  @media screen and (min-width: 750px) {
    .collection-carousel-{{ section.id }} {
      padding: 48px 40px;
    }

    .collection-carousel-{{ section.id }}__heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }

    .collection-carousel-{{ section.id }}__track {
      gap: 24px;
    }

    .collection-carousel-{{ section.id }}__card {
      flex: 0 0 {{ section.settings.card_width_desktop }}px;
    }

    .collection-carousel-{{ section.id }}__image-wrapper {
      {%- if section.settings.image_height_desktop > 0 -%}
        height: {{ section.settings.image_height_desktop }}px;
      {%- endif -%}
    }

    .collection-carousel-{{ section.id }}__title {
      font-size: {{ section.settings.title_font_size_desktop }}px;
    }

    .collection-carousel-{{ section.id }}__arrow {
      top: calc({{ image_height_desktop_px }}px / 2);
    }

    .collection-carousel-{{ section.id }}__arrow--prev { left: -16px; }
    .collection-carousel-{{ section.id }}__arrow--next { right: -16px; }
  }
</style>

<script>
  (function () {
    var sectionId = {{ section.id | json }};

    // Click-and-drag horizontal scrolling, in addition to native
    // touch/trackpad scroll. Small mouse movements still count as a
    // normal click on a card — dragging only kicks in past a small
    // movement threshold.
    function enableDragScroll(el) {
      if (el.dataset.dragScrollInit) return;
      el.dataset.dragScrollInit = 'true';

      var isDown = false;
      var startX = 0;
      var startScrollLeft = 0;

      el.addEventListener('mousedown', function (e) {
        isDown = true;
        el.classList.add('is-dragging');
        startX = e.pageX;
        startScrollLeft = el.scrollLeft;
      });

      function stopDrag() {
        isDown = false;
        el.classList.remove('is-dragging');
      }

      el.addEventListener('mouseleave', stopDrag);
      el.addEventListener('mouseup', stopDrag);

      el.addEventListener('mousemove', function (e) {
        if (!isDown) return;
        var delta = e.pageX - startX;
        if (Math.abs(delta) > 3) {
          e.preventDefault();
          el.scrollLeft = startScrollLeft - delta;
        }
      });
    }

    function initCarousel() {
      var section = document.querySelector('.collection-carousel-' + sectionId);
      if (!section) return;
      var track = section.querySelector('[data-carousel-track]');
      var prevBtn = section.querySelector('[data-carousel-prev]');
      var nextBtn = section.querySelector('[data-carousel-next]');
      if (!track) return;

      enableDragScroll(track);

      function scrollByCard(direction) {
        var card = track.querySelector('.collection-carousel-' + sectionId + '__card');
        if (!card) return;
        var cardWidth = card.getBoundingClientRect().width;
        var gap = parseInt(getComputedStyle(track).gap || 0, 10);
        track.scrollBy({ left: (cardWidth + gap) * direction, behavior: 'smooth' });
      }

      if (prevBtn && !prevBtn.dataset.carouselInit) {
        prevBtn.dataset.carouselInit = 'true';
        prevBtn.addEventListener('click', function () { scrollByCard(-1); });
      }
      if (nextBtn && !nextBtn.dataset.carouselInit) {
        nextBtn.dataset.carouselInit = 'true';
        nextBtn.addEventListener('click', function () { scrollByCard(1); });
      }
    }

    // Runs on normal page load, AND re-runs whenever the theme editor
    // reloads this specific section after a settings change — without
    // this listener, the buttons/drag would only ever work on the very
    // first load and go dead after any edit.
    initCarousel();
    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail && event.detail.sectionId === sectionId) initCarousel();
    });
  })();
</script>

{% schema %}
{
  "name": "Collection Carousel",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Commit to Wellness | View our Current Bundle Options"
    },
    {
      "type": "select",
      "id": "heading_position",
      "label": "Heading position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size (mobile)",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "label": "Heading size (desktop)",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Card size"
    },
    {
      "type": "paragraph",
      "content": "Controls the fixed size of each card/image directly. Cards no longer resize to fit 3 per row — however many fit at this size show per view, and the rest scroll."
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "label": "Card width (mobile)",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "card_width_desktop",
      "label": "Card width (desktop)",
      "min": 120,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Image height (mobile)",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "label": "Image height (desktop)",
      "min": 0,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Collection title"
    },
    {
      "type": "select",
      "id": "title_font",
      "label": "Font",
      "options": [
        { "value": "var(--font-body--family)", "label": "Body" },
        { "value": "var(--font-subheading--family)", "label": "Subheading" },
        { "value": "var(--font-heading--family)", "label": "Heading" },
        { "value": "var(--font-accent--family)", "label": "Accent" }
      ],
      "default": "var(--font-body--family)"
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "Title size (mobile)",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_font_size_desktop",
      "label": "Title size (desktop)",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Custom title",
          "info": "Leave blank to use the collection's own title."
        },
        {
          "type": "color",
          "id": "image_background_color",
          "label": "Image background color",
          "info": "Useful if the collection image is a transparent PNG."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Carousel",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
