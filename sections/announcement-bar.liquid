{% comment %}
  Sliding Announcement Bar
  ------------------------------------------------------------
  Pure CSS marquee — no JavaScript at all.

  Each side of the loop (.announcement-bar__group) repeats the
  full block sequence REPEAT_COUNT times, not just once. That's
  the fix for gaps/cutoffs: if a merchant's text is short, one
  copy of it might not be wide enough to fill even a normal
  screen, let alone a wide monitor — so the marquee would show
  a blank stretch before looping. Repeating it several times per
  side guarantees there's always enough content to cover the
  full viewport width, on any screen size, regardless of how
  short the announcement text is.

  Both groups are otherwise identical, so animating exactly
  -50% still produces a perfectly seamless loop — the repeat
  count only adds density, it doesn't change that math.

  If you still see a gap on an unusually wide display, raise
  repeat_count below.
{% endcomment %}

{%- liquid
  assign repeat_count = 10
  assign total_duration = section.settings.speed | times: repeat_count
-%}

<style>
  #shopify-section-{{ section.id }} .announcement-bar {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
    width: 100%;
    padding: {{ section.settings.padding_block }}px 0;
  }

  #shopify-section-{{ section.id }} .announcement-bar__track {
    overflow: hidden;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .announcement-bar__content {
    display: flex;
    width: max-content;
    white-space: nowrap;
    animation: announcement-marquee-{{ section.id }} {{ total_duration }}s linear infinite;
    will-change: transform;
  }

  {% if section.settings.pause_on_hover %}
    #shopify-section-{{ section.id }} .announcement-bar__track:hover .announcement-bar__content {
      animation-play-state: paused;
    }
  {% endif %}

  #shopify-section-{{ section.id }} .announcement-bar__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .announcement-bar__item {
    padding-inline: {{ section.settings.item_spacing }}px;
    font-size: var(--font-size--base, {{ section.settings.font_size }}px);
    font-weight: 400;
    letter-spacing: {{ section.settings.letter_spacing }}px;
  }

  #shopify-section-{{ section.id }} .announcement-bar__item a {
    color: inherit;
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .announcement-bar__separator {
    opacity: 0.5;
    flex-shrink: 0;
  }

  @keyframes announcement-marquee-{{ section.id }} {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* Respect reduced-motion preference: keep the bar readable and
     static instead of forcing continuous motion. */
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .announcement-bar__content {
      animation: none;
    }

    #shopify-section-{{ section.id }} .announcement-bar__group:nth-child(2) {
      display: none;
    }
  }
</style>

<div class="announcement-bar">
  <div class="announcement-bar__track">
    <div class="announcement-bar__content">
      {%- if section.blocks.size > 0 -%}
        {%- for group_index in (1..2) -%}
          <div class="announcement-bar__group" {% if group_index == 2 %}aria-hidden="true"{% endif %}>
            {%- for lap in (1..repeat_count) -%}
              {%- for block in section.blocks -%}
                {%- assign is_real = false -%}
                {%- if group_index == 1 and lap == 1 -%}
                  {%- assign is_real = true -%}
                {%- endif -%}

                <span
                  class="announcement-bar__item"
                  {% if is_real %}
                    {{ block.shopify_attributes }}
                  {% else %}
                    aria-hidden="true"
                  {% endif %}
                >
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" {% unless is_real %}tabindex="-1"{% endunless %}>
                      {{ block.settings.text }}
                    </a>
                  {%- else -%}
                    {{ block.settings.text }}
                  {%- endif -%}
                </span>
                {%- if section.settings.show_separator -%}
                  <span class="announcement-bar__separator" aria-hidden="true">•</span>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="announcement-bar__group">
          <span class="announcement-bar__item">Add announcement text in the section settings</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sliding announcement bar",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Speed (seconds per pass)",
      "min": 3,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 12,
      "info": "Time for one full phrase to scroll past. Higher = slower. This stays consistent no matter how much text you add."
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show separator dot between items",
      "default": true
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Spacing between items",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 0.5
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Add your announcement text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sliding announcement bar",
      "blocks": [
        { "type": "text", "settings": { "text": "Free shipping on orders over $150" } },
        { "type": "text", "settings": { "text": "Now open in Richmond, VIC" } }
      ]
    }
  ]
}
{% endschema %}
