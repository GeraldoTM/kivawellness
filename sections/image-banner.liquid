{% liquid
  assign heading = section.settings.heading
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
%}

<div class="image-bg-banner-{{ section.id }}">
  <div class="image-bg-banner-{{ section.id }}__content image-bg-banner-{{ section.id }}__content--{{ section.settings.button_position_vertical }} image-bg-banner-{{ section.id }}__content--{{ section.settings.button_position_horizontal }}">
    {%- if heading != blank -%}
      <h2 class="image-bg-banner-{{ section.id }}__heading">{{ heading }}</h2>
    {%- endif -%}

    {%- if button_label != blank -%}
      <a
        href="{{ button_link | default: '#' }}"
        class="image-bg-banner-{{ section.id }}__button"
        style="
          background-color: {{ section.settings.button_bg_color | default: '#1a1a1a' }};
          color: {{ section.settings.button_text_color | default: '#ffffff' }};
          border-radius: {{ section.settings.button_radius }}px;
        "
      >
        {{ button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

<style>
  .image-bg-banner-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    height: {{ section.settings.height_mobile }}px;
    {%- if section.settings.image_mobile != blank -%}
      background-image: url('{{ section.settings.image_mobile | image_url: width: 1500 }}');
    {%- elsif section.settings.image_desktop != blank -%}
      background-image: url('{{ section.settings.image_desktop | image_url: width: 1500 }}');
    {%- endif -%}
    background-size: cover;
    background-position: center;
  }

  {%- if section.settings.overlay_opacity > 0 -%}
    .image-bg-banner-{{ section.id }}::before {
      content: '';
      position: absolute;
      inset: 0;
      background: #000;
      opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      z-index: 1;
    }
  {%- endif -%}

  .image-bg-banner-{{ section.id }}__content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
  }

  .image-bg-banner-{{ section.id }}__content--top { justify-content: flex-start; }
  .image-bg-banner-{{ section.id }}__content--middle { justify-content: center; }
  .image-bg-banner-{{ section.id }}__content--bottom { justify-content: flex-end; }

  .image-bg-banner-{{ section.id }}__content--left { align-items: flex-start; text-align: left; }
  .image-bg-banner-{{ section.id }}__content--center { align-items: center; text-align: center; }
  .image-bg-banner-{{ section.id }}__content--right { align-items: flex-end; text-align: right; }

  .image-bg-banner-{{ section.id }}__heading {
    color: #fff;
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    margin: 0;
    max-width: 90%;
  }

  .image-bg-banner-{{ section.id }}__button {
    display: inline-block;
    padding: 10px 20px;
    font-size: {{ section.settings.button_font_size_mobile }}px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  @media screen and (min-width: 750px) {
    .image-bg-banner-{{ section.id }} {
      height: {{ section.settings.height_desktop }}px;
      {%- if section.settings.image_desktop != blank -%}
        background-image: url('{{ section.settings.image_desktop | image_url: width: 3000 }}');
      {%- endif -%}
    }

    .image-bg-banner-{{ section.id }}__content {
      padding: 48px;
    }

    .image-bg-banner-{{ section.id }}__heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }

    .image-bg-banner-{{ section.id }}__button {
      padding: 14px 28px;
      font-size: {{ section.settings.button_font_size_desktop }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Image Banner",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background image" },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "If left blank, the desktop image is used on mobile too."
    },

    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image Placeholder"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop New"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },

    { "type": "header", "content": "Text size" },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size (mobile)",
      "min": 14,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "button_font_size_mobile",
      "label": "Button text size (mobile)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "button_font_size_desktop",
      "label": "Button text size (desktop)",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    { "type": "header", "content": "Content position" },
    {
      "type": "select",
      "id": "button_position_vertical",
      "label": "Vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "button_position_horizontal",
      "label": "Horizontal position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },

    { "type": "header", "content": "Button style" },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 4
    },

    { "type": "header", "content": "Overlay" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay darkness",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },

    { "type": "header", "content": "Section height" },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile height",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop height",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 480
    }
  ],
  "presets": [
    { "name": "Image Banner" }
  ]
}
{% endschema %}
