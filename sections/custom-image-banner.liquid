{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} image-banner-section section-{{ section.id }}-padding">
  <div class="image-banner-section__wrapper{% unless section.settings.full_width %} page-width{% endunless %}">
    <div
      class="image-banner{% if section.settings.full_width %} image-banner--full-width{% endif %} content-position--{{ section.settings.content_position }}"
      style="--image-banner-height: {{ section.settings.image_height }}px; --image-banner-height-mobile: {{ section.settings.image_height_mobile }}px;"
    >
      <div class="image-banner__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 3000 }}"
            srcset="
              {{ section.settings.image | image_url: width: 500 }} 500w,
              {{ section.settings.image | image_url: width: 750 }} 750w,
              {{ section.settings.image | image_url: width: 1100 }} 1100w,
              {{ section.settings.image | image_url: width: 1500 }} 1500w,
              {{ section.settings.image | image_url: width: 2000 }} 2000w,
              {{ section.settings.image | image_url: width: 3000 }} 3000w
            "
            sizes="100vw"
            alt="{{ section.settings.image.alt | escape }}"
            class="image-banner__image"
            loading="{% if section.index == 1 %}eager{% else %}lazy{% endif %}"
            {% if section.index == 1 %}
              fetchpriority="high"
            {% endif %}
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        {%- else -%}
          <div class="image-banner__image image-banner__image--placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'image-banner__placeholder-svg' }}
          </div>
        {%- endif -%}

        {%- if section.settings.overlay_opacity > 0 -%}
          <div
            class="image-banner__overlay"
            style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
          ></div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="image-banner__content">
          <div class="image-banner__content-inner" style="text-align: {{ section.settings.text_alignment }};">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'heading' -%}
                  {%- if block.settings.heading != blank -%}
                    <{{ block.settings.heading_size }}
                      class="image-banner__heading"
                      {% if block.settings.heading_color != blank %}
                        style="color: {{ block.settings.heading_color }};"
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.heading }}
                    </{{ block.settings.heading_size }}>
                  {%- endif -%}

                {%- when 'text' -%}
                  {%- if block.settings.text != blank -%}
                    <div class="image-banner__text rte" {{ block.shopify_attributes }}>
                      {{ block.settings.text }}
                    </div>
                  {%- endif -%}

                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link != blank %}
                        href="{{ block.settings.button_link }}"
                      {% else %}
                        role="link" aria-disabled="true"
                      {% endif %}
                      class="button button--{{ block.settings.button_style }} image-banner__button"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.button_label }}
                    </a>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .image-banner-section {
    background-color: var(--color-background);
    color: rgb(var(--color-foreground-rgb));
  }

  .image-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--style-border-radius, 0);
  }

  .image-banner__media {
    position: relative;
    width: 100%;
    height: var(--image-banner-height-mobile, 350px);
  }

  @media screen and (min-width: 750px) {
    .image-banner__media {
      height: var(--image-banner-height, 500px);
    }
  }

  .image-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .image-banner__image--placeholder {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .image-banner__image--placeholder .image-banner__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .image-banner__overlay {
    position: absolute;
    inset: 0;
  }

  /* Text sits inside the image, positioned via a 9-point grid driven
     by the "Content position" setting. */
  .image-banner__content {
    position: absolute;
    inset: 0;
    display: flex;
    padding: var(--padding-3xl, 40px);
  }

  .image-banner__content-inner {
    max-width: 640px;
    display: flex;
    flex-direction: column;
  }

  .content-position--top-left .image-banner__content { align-items: flex-start; justify-content: flex-start; }
  .content-position--top-center .image-banner__content { align-items: flex-start; justify-content: center; }
  .content-position--top-right .image-banner__content { align-items: flex-start; justify-content: flex-end; }
  .content-position--middle-left .image-banner__content { align-items: center; justify-content: flex-start; }
  .content-position--middle-center .image-banner__content { align-items: center; justify-content: center; }
  .content-position--middle-right .image-banner__content { align-items: center; justify-content: flex-end; }
  .content-position--bottom-left .image-banner__content { align-items: flex-end; justify-content: flex-start; }
  .content-position--bottom-center .image-banner__content { align-items: flex-end; justify-content: center; }
  .content-position--bottom-right .image-banner__content { align-items: flex-end; justify-content: flex-end; }

  .image-banner__heading {
    margin: 0 0 var(--gap-xl, 16px);
  }

  .image-banner__text {
    font-size: var(--font-size--base);
    line-height: 160%;
  }

  .image-banner__text p {
    margin: 0 0 var(--gap-xl, 16px);
  }

  .image-banner__text p:last-child {
    margin-bottom: 0;
  }

  .image-banner__button {
    display: inline-block;
    margin-top: var(--gap-xl, 24px);
    width: fit-content;
  }

  .image-banner__content-inner[style*='text-align: center'] .image-banner__button {
    margin-inline: auto;
  }

  .image-banner__content-inner[style*='text-align: right'] .image-banner__button {
    margin-inline-start: auto;
  }

  @media screen and (max-width: 749px) {
    .image-banner__content {
      padding: var(--padding-3xl, 24px) var(--padding-inline, 20px);
    }

    .image-banner__content-inner {
      max-width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image banner",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": true,
      "info": "When off, the image is constrained to the page's normal content width."
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Height (desktop)",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Height (mobile)",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 350
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 20,
      "info": "Darkens or tints the image so text stays readable."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Add a headline"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "h2", "label": "Large" },
            { "value": "h3", "label": "Medium" },
            { "value": "h4", "label": "Small" }
          ],
          "default": "h2"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color",
          "info": "Leave blank to use the color scheme's default text color."
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Pair large text with an image to tell a story, promote a sale, or welcome customers to your store.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image banner",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
